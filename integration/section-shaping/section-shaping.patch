diff --git a/engine/crates/seq-core/src/song_shape.rs b/engine/crates/seq-core/src/song_shape.rs
new file mode 100644
index 00000000..521cd331
--- /dev/null
+++ b/engine/crates/seq-core/src/song_shape.rs
@@ -0,0 +1,59 @@
+// Section overlays are evaluated at the existing clip emission point. They
+// never write source material, actor parameters, clocks, or gate ownership.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SectionShape {
+    pub energy: i16, // -100..100; relative velocity 50..150 percent
+    pub space: u16,  // 0..100; omit 0..75 percent, gate 100..25 percent
+}
+
+impl SectionShape {
+    fn apply(self, random: u32, velocity: u8, duration: u32, protected: bool) -> Option<(u8, u32)> {
+        if self == Self::default() { return Some((velocity, duration)); }
+        // One fixed rank per actor/clip phase. Increasing Space only removes
+        // additional eligible attacks; it never rolls a replacement pattern.
+        if !protected && random % 10000 < u32::from(self.space) * 75 { return None; }
+        let velocity = if velocity == 0 { 0 } else {
+            ((i64::from(velocity) * (200 + i64::from(self.energy)) + 100) / 200).clamp(1, 127) as u8
+        };
+        let duration = ((u64::from(duration) * (400 - u64::from(self.space) * 3) + 200) / 400)
+            .clamp(1, u64::from(u32::MAX)) as u32;
+        Some((velocity, duration))
+    }
+}
+
+impl Engine {
+    fn song_shape_active(&self) -> bool {
+        self.playing && self.song_start_bar.is_some()
+            && self.song_sections.contains_key(&self.song_pos)
+    }
+
+    fn song_shape(&self) -> SectionShape {
+        if self.song_shape_active() { self.song_sections[&self.song_pos].shape }
+        else { SectionShape::default() }
+    }
+
+    /// Optional sh1 save line, following the corresponding ss1 recipe. Strict
+    /// parsing avoids creating an occurrence from an orphan or corrupt line.
+    pub fn song_shape_set(&mut self, message: &str) -> bool {
+        let fields: Vec<_> = message.split_whitespace().collect();
+        let [index, energy, space] = fields.as_slice() else { return false; };
+        let (Ok(index), Ok(energy), Ok(space)) = (index.parse::<usize>(), energy.parse::<i16>(), space.parse::<u16>()) else { return false; };
+        if !(-100..=100).contains(&energy) || space > 100 { return false; }
+        let Some(section) = self.song_sections.get_mut(&index) else { return false; };
+        section.shape = SectionShape { energy, space };
+        true
+    }
+
+    pub fn song_shape_message(&self, index: usize) -> Option<String> {
+        self.song.get(index)?;
+        let shape = self.song_sections.get(&index).map_or(SectionShape::default(), |section| section.shape);
+        Some(format!("{} {} {}", index, shape.energy, shape.space))
+    }
+
+    fn song_shape_snapshot(&self) -> String {
+        let target = self.song_sections.get(&self.song_pos).map_or(SectionShape::default(), |section| section.shape);
+        let effective = self.song_shape();
+        format!("{{\"scope\":\"follower-clips\",\"active\":{},\"target\":{{\"energy\":{},\"space\":{}}},\"effective\":{{\"energy\":{},\"space\":{}}}}}",
+            self.song_shape_active(), target.energy, target.space, effective.energy, effective.space)
+    }
+}
