index 00000000..9d5e48ae
--- /dev/null
+++ b/engine/crates/seq-core/src/song_shape_tests.rs
@@ -0,0 +1,194 @@
+#[cfg(test)]
+mod song_shape_tests {
+    use super::*;
+    use crate::{command::apply_batch, persist};
+
+    fn fixture(energy: i16, space: u16) -> Engine {
+        let mut engine = Engine::new(48000, 12000);
+        for track in 0..4 {
+            for tick in (0..TICKS_PER_BAR).step_by(24) {
+                for pitch in [60, 64, 67] {
+                    engine.tracks[track].active_mut().add_note_raw((tick/24) as u16, tick, 18, pitch, 80);
+                }
+            }
+        }
+        engine.follower_input_context("fic1,0,1,14");
+        engine.song = vec![0];
+        engine.song_section_edit(&format!("0 energy {energy}"));
+        engine.song_section_edit(&format!("0 space {space}"));
+        engine
+    }
+
+    fn trace(engine: &mut Engine, count: usize) -> Vec<(usize, u8, u8, u8, bool)> {
+        let mut trace = Vec::new();
+        for tick in 0..count {
+            let mut output = Vec::new();
+            engine.advance_block(250, &mut output); // real audio clock, 48 kHz / 120 BPM
+            for event in output {
+                match event {
+                    OutEvent::NoteOn{track,pitch,vel} | OutEvent::RenderedOn{track,pitch,vel} => trace.push((tick,track,pitch,vel,true)),
+                    OutEvent::NoteOff{track,pitch} | OutEvent::RenderedOff{track,pitch} => trace.push((tick,track,pitch,0,false)),
+                    _ => {},
+                }
+            }
+        }
+        trace.sort_unstable(); // simultaneous independent releases can swap order in the shared gate vector
+        trace
+    }
+
+    #[test]
+    fn neutral_shape_is_exact_with_variation_and_does_not_rewrite_state() {
+        let mut plain = fixture(0, 0);
+        let mut shaped = fixture(0, 0);
+        plain.song_sections.clear();
+        for engine in [&mut plain, &mut shaped] { engine.variation_set("1 70 30 50 25 8"); }
+        let saved = persist::serialize(&shaped);
+        plain.play(); shaped.play();
+        assert_eq!(trace(&mut plain, 768), trace(&mut shaped, 768));
+        shaped.stop(&mut Vec::new());
+        assert_eq!(persist::serialize(&shaped), saved);
+    }
+
+    #[test]
+    fn energy_is_monotonic_and_space_removes_a_nested_set_of_attacks() {
+        let mut last_count = usize::MAX;
+        let mut prior: Option<Vec<(usize,u8)>> = None;
+        for space in [0, 25, 50, 75, 100] {
+            let mut engine = fixture(0, space); engine.play();
+            let events = trace(&mut engine, 768);
+            let attacks: Vec<_> = events.iter().filter(|event| event.1==1 && event.4).map(|event|(event.0,event.2)).collect();
+            assert!(attacks.len() <= last_count);
+            if let Some(prior) = prior { assert!(attacks.iter().all(|event|prior.contains(event))); }
+            assert!(attacks.contains(&(0,60)) && attacks.contains(&(384,60)), "downbeats survive");
+            let first: Vec<_> = attacks.iter().filter(|event|event.0<384).copied().collect();
+            let second: Vec<_> = attacks.iter().filter(|event|event.0>=384).map(|event|(event.0-384,event.1)).collect();
+            assert_eq!(first, second);
+            assert_eq!(events.iter().filter(|event|event.1==1&&event.4).count(), events.iter().filter(|event|event.1==1&&!event.4).count());
+            last_count = attacks.len(); prior = Some(attacks);
+        }
+        assert!(last_count < 96);
+        for energy in [-100, 0, 100] {
+            let mut engine = fixture(energy, 0); engine.play();
+            let events = trace(&mut engine, 384);
+            assert!(events.iter().filter(|event|event.1==1&&event.4).all(|event|event.3==(80*(200+i32::from(energy))/200) as u8));
+            assert!(events.iter().filter(|event|event.1==0&&event.4).all(|event|event.3==80), "conductor exact");
+            assert_eq!(events.iter().filter(|event|event.1==1&&event.4).count(), 48);
+        }
+    }
+
+    #[test]
+    fn section_boundary_changes_shape_once_without_restarting_woven_donors() {
+        let mut engine = fixture(-100, 0);
+        engine.song = vec![0,0,0];
+        for index in 0..3 {
+            engine.song_section_edit(&format!("{index} bars 1"));
+            for track in 0..4 {engine.song_section_edit(&format!("{index} track {track} 1"));}
+        }
+        engine.song_section_edit("1 energy 100");
+        engine.tracks[2].clips[0].set_loop(0,48);
+        engine.tracks[3].clips[0].set_loop(0,64);
+        for tick in [384,768] {engine.tracks[3].clips[0].add_note_raw((tick/24) as u16,tick,18,60,80);}
+        engine.source_route_set("1 1 2 0 3 0 1 -1 -1 -1 -1");
+        engine.play();
+        let events = trace(&mut engine, 780);
+        for (tick,velocity) in [(0,40),(384,120),(768,80)] {
+            assert!(events.iter().any(|event|event.0==tick&&event.1==1&&event.3==velocity&&event.4), "boundary {tick}: {events:?}");
+        }
+        assert_eq!(engine.tracks[2].pos_tick,780);
+        assert_eq!(engine.tracks[3].pos_tick,780);
+        assert_eq!(engine.tracks[3].cycle,1);
+        assert_eq!(engine.variations[1],Default::default());
+        engine.stop(&mut Vec::new());assert!(engine.gates.is_empty());
+        assert_eq!(engine.song_shape(), SectionShape::default());
+    }
+
+    #[test]
+    fn boundary_keeps_existing_gate_and_shortens_only_the_new_attack() {
+        let mut engine=fixture(0,0);
+        engine.tracks[1].clips[0].notes.clear();
+        engine.tracks[1].clips[0].set_loop(0,32);
+        engine.tracks[1].clips[0].add_note_raw(0,0,600,60,80);
+        engine.tracks[1].clips[0].add_note_raw(17,408,100,72,80);
+        engine.tracks[1].clips[0].notes[1].actions=Some([0;crate::recorded_actions::LANES+1]);
+        engine.song=vec![0,0];
+        engine.song_section_edit("0 bars 1");
+        engine.song_section_edit("1 bars 1");
+        engine.song_section_edit("1 track 1 1");
+        engine.song_section_edit("1 space 100");
+        engine.play();let events=trace(&mut engine,700);
+        let releases: Vec<_>=events.iter().filter(|event|event.1==1&&!event.4).map(|event|(event.0,event.2)).collect();
+        assert_eq!(releases,vec![(433,72),(600,60)]);
+        assert!(engine.gates.iter().all(|gate|gate.track!=1));
+    }
+
+    #[test]
+    fn saved_shapes_undo_legacy_load_and_strict_edits() {
+        let mut engine = fixture(-40,65);
+        let saved = persist::serialize(&engine);
+        assert!(saved.contains("ss1 0 0 0000000000000000\nsh1 0 -40 65\n"));
+        let mut restored = Engine::new(48000,12000);
+        assert!(persist::load(&mut restored,&saved));
+        assert_eq!(persist::serialize(&restored),saved);
+        restored.follower_input_context("fic1,0,1,14");engine.play();restored.play();
+        assert_eq!(trace(&mut engine,384),trace(&mut restored,384));
+        engine.stop(&mut Vec::new());
+        apply_batch(&mut engine,"usnap 1;songsection 0 energy 90;songsection 0 space 0;uswap 1 2",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].shape,SectionShape{energy:-40,space:65});
+        for command in ["0 energy -101","0 energy 101","0 space -1","0 space 101","0 space 2 junk"] {
+            assert!(!engine.song_section_edit(command));
+        }
+        for invalid in ["0 -101 2","0 2 101","0 0 0 junk","9 0 0"] {assert!(!engine.song_shape_set(invalid));}
+        engine.pending_play=true;
+        apply_batch(&mut engine,"songsection 0 energy 1;songsection 0 space 1",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].shape,SectionShape{energy:-40,space:65});
+        engine.pending_play=false;engine.play();
+        apply_batch(&mut engine,"songsection 0 energy 1;songsection 0 space 1",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].shape,SectionShape{energy:-40,space:65});
+        assert!(persist::load(&mut engine,"movy1\nsg 0\nss1 0 4 0000000000000000\n"));
+        assert_eq!(engine.song_sections[&0].shape,SectionShape::default());
+    }
+
+    #[test]
+    fn recording_rendered_and_live_notes_bypass_shape_and_operations_survive() {
+        let mut plain = fixture(0,0); let mut shaped = fixture(100,100);
+        for engine in [&mut plain,&mut shaped] {
+            for note in &mut engine.tracks[2].clips[0].notes {note.rendered=true;}
+            engine.play();engine.recording=true;engine.rec_track=1;
+        }
+        let plain_trace = trace(&mut plain,384); let shaped_trace = trace(&mut shaped,384);
+        assert_eq!(plain_trace.iter().filter(|event|event.1<=2).collect::<Vec<_>>(),shaped_trace.iter().filter(|event|event.1<=2).collect::<Vec<_>>());
+        for engine in [&mut plain, &mut shaped] {
+            engine.rec_track=3;
+            engine.live_note_on(3,72,80);
+            assert_eq!(engine.rec_pending.last().unwrap().vel,80);
+            trace(engine,12);
+            engine.live_note_off(3,72);
+            let note=engine.tracks[3].clips[0].notes.iter().find(|note|note.pitch==72).unwrap();
+            assert_eq!((note.vel,note.gate),(80,12));
+        }
+        let mut protected=fixture(0,100);
+        for note in &mut protected.tracks[1].clips[0].notes { note.actions=Some([0;crate::recorded_actions::LANES+1]); }
+        protected.play();
+        assert_eq!(trace(&mut protected,384).iter().filter(|event|event.1==1&&event.4).count(),48);
+        let shape=SectionShape{energy:0,space:100};
+        assert_eq!(shape.apply(0,80,400,true),Some((80,100)));
+        assert_eq!(shape.apply(0,80,400,false),None);
+        assert_eq!(shape.apply(9999,0,u32::MAX,true),Some((0,1073741824)));
+    }
+
+    #[test]
+    fn shape_observation_is_neutral_and_effective_only_after_launch() {
+        let mut engine=fixture(50,40);
+        let target="\"target\":{\"energy\":50,\"space\":40}";
+        assert!(engine.song_section_snapshot().contains(target));
+        assert!(engine.song_section_snapshot().contains("\"effective\":{\"energy\":0,\"space\":0}"));
+        engine.play();assert_eq!(engine.song_shape(),SectionShape::default());
+        trace(&mut engine,1);
+        assert_eq!(engine.song_shape(),SectionShape{energy:50,space:40});
+        let saved=persist::serialize(&engine);let tick=engine.master_tick;
+        let snapshot=engine.song_section_snapshot();
+        for _ in 0..100 {assert_eq!(engine.song_section_snapshot(),snapshot);}
