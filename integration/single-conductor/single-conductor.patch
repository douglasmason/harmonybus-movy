+/** Explicit, stopped-only migration through the existing parameter Undo journal. */
+import {singleConductor,restoreSessionRoles,sessionRolesSnapshot} from './session-roles.js';
+import {appState} from '../app/state.js';
+import {portFor} from '../track/registry.js';
+import {trackKind} from '../track/ref.js';
+import {seqState} from './state.js';
+import {engineReady,fieldEngineSet} from './engine.js';
+import {seqToast} from './render.js';
+import {markUiStateDirty} from './ui-dirty.js';
+import {beginEdit,endEdit,CLOSE} from '../undo/group.js';
+import {recordParamOp,recordUiOp} from '../undo/record.js';
+import {chordRoutingState,useSessionConductor} from './chord-play.js';
+
+export function conductorLayoutLabel():string {return singleConductor()?'Track1':'Legacy';}
+export function convertToSingleConductor():boolean {
+    if(singleConductor())return true;
+    if(!engineReady()||!seqState.engineOk){seqToast('Wait for engine');return false;}
+    if(seqState.playing||seqState.recording){seqToast('Stop before conversion');return false;}
+    if(trackKind(0)!=='movy'){seqToast('Track 1 must use Movy');return false;}
+    const changes:{track:number;old:string;next:string}[]=[];
+    for(let track=0;track<16;track++) {
+        const port=portFor(track),module=port.getParam('midi_fx1_module');
+        if(module!=='harmonybus'){
+            if(track===0||module===null||module==='--'){seqToast('Wait for track modules');return false;}
+            continue;
+        }
+        const role=port.getParam('midi_fx1:track_role');
+        if(!role||!['Conductor','Follower','Off','Receiver'].includes(role)){seqToast('Wait for track roles');return false;}
+        const next=track===0?'Conductor':role==='Conductor'?'Off':role;
+        if(next!==role)changes.push({track,old:role,next});
+    }
+    // End source gestures before HB's existing role-change voice flush runs.
+    fieldEngineSet('joint_release','1');fieldEngineSet('chord_select','off');
+    beginEdit({key:'single-conductor',verb:'SINGLE CONDUCTOR',target:'Session',close:CLOSE.IMMEDIATE,seq:false});
+    const applied:typeof changes=[];
+    try {
+        for(const change of changes) {
+            if(!portFor(change.track).setParam('midi_fx1:track_role',change.next)){
+                let restored=true;
+                for(const old of applied.reverse()){
+                    if(portFor(old.track).setParam('midi_fx1:track_role',old.old))recordParamOp(old.track,'midi_fx1:track_role',old.old,old.old);
+                    else restored=false;
+                }
+                if(!restored){markUiStateDirty();appState.dirty=true;}
+                seqToast(restored?'Conversion failed; unchanged':'Conversion failed / Undo');return false;
+            }
+            applied.push(change);
+            recordParamOp(change.track,'midi_fx1:track_role',change.old,change.next);
+        }
+        const before=chordRoutingState();useSessionConductor();
+        recordUiOp('chordRouting',before,chordRoutingState());
+        recordUiOp('roleLayout',String(sessionRolesSnapshot()),'1');restoreSessionRoles(1);
+    }finally {endEdit();}
+    markUiStateDirty();appState.dirty=true;seqToast('Track 1 conductor / Undo');return true;
+}
+export function turnConductorLayout(delta:number):void {
+    if(delta>0)convertToSingleConductor();
+    else if(delta<0&&singleConductor())seqToast('Undo restores prior setup');
+}
