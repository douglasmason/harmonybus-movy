 impl Engine {
+    /// Replace only this drum's attacks in the tail of the active loop.
+    /// Planning and capacity checks precede mutation; no partial fills or new clock.
+    pub fn fill_drum_tail(&mut self, message: &str) -> bool {
+        let fields: Vec<_> = message.split_whitespace().collect();
+        let [track, pitch, span, grid, velocity] = fields.as_slice() else { return false; };
+        let (Ok(track), Ok(pitch), Ok(span), Ok(grid), Ok(velocity)) =
+            (track.parse::<usize>(), pitch.parse::<u8>(), span.parse::<u32>(), grid.parse::<u32>(), velocity.parse::<u8>())
+            else { return false; };
+        if track >= self.tracks.len() || !self.track_is_drum(track)
+            || !self.song_sections_editable() || self.recording || pitch > 127
+            || !(1..=127).contains(&velocity) || !matches!(span, 96 | 192 | 384)
+            || !matches!(grid, 24 | 48 | 96 | 192 | 384) { return false; }
+        let clip = self.tracks[track].active();
+        if !clip.exists() { return false; }
+        let end = clip.loop_end_ticks();
+        let start = end.saturating_sub(span).max(clip.loop_start_ticks());
+        let replacement_count = clip.notes.iter().filter(|note|
+            note.pitch == pitch && (start..end).contains(&note.tick)).count();
+        let count = (end - start).div_ceil(grid) as usize;
+        if clip.notes.len() - replacement_count + count > crate::clip::MAX_NOTES { return false; }
+        let clip = self.tracks[track].active_mut();
+        clip.notes.retain(|note| note.pitch != pitch || !(start..end).contains(&note.tick));
+        for tick in (start..end).step_by(grid as usize) {
+            clip.notes.push(Note { tick, gate: (grid / 2).min(12).min(end-tick).max(1),
+                pitch, vel: velocity, step: (tick / TICKS_PER_STEP) as u16,
+                suppress: false, fired: false, actions: None, input_key: None,
+                rendered: false, pressure: Vec::new() });
+        }
+        true
+    }
