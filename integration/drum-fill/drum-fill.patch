+mod drum_fill_tests {
+    use crate::{engine::Engine, clip::{Note, MAX_NOTES}, command::apply_batch, persist};
+    fn setup() -> Engine {
+        let mut engine=Engine::new(48000,12000);
+        engine.set_track_drum(0,true);
+        let clip=engine.tracks[0].active_mut();
+        clip.length_steps=16; clip.loop_start_steps=16;
+        for (tick,pitch) in [(24,38),(384,36),(660,38),(680,38),(700,42),(768,38)] {
+            clip.notes.push(Note {tick,pitch,gate:10,vel:90,step:(tick/24) as u16,
+                actions:None,input_key:None,rendered:false,suppress:false,fired:false,pressure:Vec::new()});
+        }
+        engine
+    }
+    #[test]
+    fn drum_fill_preserves_other_lanes_outside_window_and_clip_settings() {
+        let mut engine=setup();
+        engine.tracks[0].active_mut().scale_num=2;
+        let preserved: Vec<_>=engine.tracks[0].active().notes.iter()
+            .filter(|note|note.pitch!=38 || !(672..768).contains(&note.tick)).cloned().collect();
+        assert!(engine.fill_drum_tail("0 38 96 24 111"));
+        let clip=engine.tracks[0].active();
+        assert_eq!(clip.notes[..preserved.len()],preserved);
+        let fill=&clip.notes[preserved.len()..];
+        assert_eq!(fill.iter().map(|note|note.tick).collect::<Vec<_>>(),vec![672,696,720,744]);
+        assert!(fill.iter().all(|note|note.pitch==38&&note.vel==111&&note.gate==12&&note.input_key.is_none()&&note.actions.is_none()));
+        assert_eq!((clip.loop_start_steps,clip.length_steps,clip.scale_num),(16,16,2));
+        let saved=persist::serialize(&engine);
+        assert!(engine.fill_drum_tail("0 38 96 24 111"));
+        assert_eq!(persist::serialize(&engine),saved,"repeat is idempotent");
+    }
+    #[test]
+    fn drum_fill_is_one_saved_undoable_edit_and_short_loops_stay_short() {
+        let mut engine=setup();let mut output=Vec::new();let before=engine.undo_snapshot();
+        apply_batch(&mut engine,"usnap 27;dfill 0 38 192 48 87;ucommit 27",&mut output);
+        let saved=persist::serialize(&engine);let mut restored=Engine::new(48000,12000);
+        assert!(persist::load(&mut restored,&saved));
+        assert_eq!(persist::serialize(&restored),saved);
+        apply_batch(&mut engine,"uswap 27 28",&mut output);assert_eq!(engine.undo_snapshot(),before);
+        engine.tracks[0].active_mut().length_steps=2;
+        assert!(engine.fill_drum_tail("0 38 384 24 100"));
+        let clip=engine.tracks[0].active();
+        assert_eq!(clip.length_steps,2);
+        assert!(clip.notes.iter().any(|note|note.pitch==38&&note.tick==384));
+        assert!(clip.notes.iter().any(|note|note.pitch==38&&note.tick==408));
+    }
+    #[test]
+    fn drum_fill_rejects_invalid_running_pending_recording_and_full_clips_atomically() {
+        let mut engine=setup();let before=persist::serialize(&engine);
+        for message in ["", "0 38 96 24 100 extra", "16 38 96 24 100", "-1 38 96 24 100", "0 128 96 24 100", "0 38 95 24 100", "0 38 96 1 100", "0 38 96 24 0", "0 38 96 24 128"] {
+            assert!(!engine.fill_drum_tail(message));assert_eq!(persist::serialize(&engine),before);
+        }
+        engine.play();assert!(!engine.fill_drum_tail("0 38 96 24 100"));
+        let mut output=Vec::new();engine.stop(&mut output);
+        engine.recording=true;assert!(!engine.fill_drum_tail("0 38 96 24 100"));engine.recording=false;
+        engine.set_track_drum(0,false);assert!(!engine.fill_drum_tail("0 38 96 24 100"));engine.set_track_drum(0,true);
+        let note=engine.tracks[0].active().notes[0].clone();
+        engine.tracks[0].active_mut().notes=vec![note;MAX_NOTES];
+        let before=persist::serialize(&engine);
+        assert!(!engine.fill_drum_tail("0 42 384 24 100"));assert_eq!(persist::serialize(&engine),before);
+        engine.tracks[0].active_mut().clear();assert!(!engine.fill_drum_tail("0 38 96 24 100"));
+    }
+}
