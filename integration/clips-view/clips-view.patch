--- /dev/null
+++ b/src/seq/clips-view.ts
@@ -0,0 +1,121 @@
+/** A fifth clip row on knob touches, using the ordinary session launch owner. */
+import { appState, VIEW_CHAIN, VIEW_KNOBS } from '../app/state.js';
+import { focusGroupStep } from '../track/focus.js';
+import { fontPrint } from '../font/index.js';
+import { drawHeader, fitHeaderText } from '../renderer/header.js';
+import { updatePerformanceKnobLEDs } from '../renderer/knob-leds.js';
+import { seqState } from './state.js';
+import { sessionLaunchCell, sessionCellColor } from './session.js';
+import { momentaryGesture } from './momentary.js';
+import { loopHeld } from './loop-mode.js';
+import { clipsPage, setClipsPage, clipsSnapshot, clipsKnobTrack, clipsRowTrack, turnClipsSetting } from './clips-layout.js';
+
+const heldKnobs = new Set<number>();
+const ownedKnobs = new Set<number>();
+export function clipsSurfaceActive(): boolean {
+    return seqState.sessionMode && [VIEW_CHAIN, VIEW_KNOBS].includes(appState.currentView);
+}
+export function clipsPanelActive(): boolean { return clipsSurfaceActive() && clipsPage < 2; }
+export function clipsMidi(data: number[]): boolean {
+    const status = data[0] & 240, key = data[1], value = data[2];
+    const touchDown = status === 144 && value > 0;
+    const touchUp = status === 128 || (status === 144 && value === 0);
+    if (key >= 0 && key < 8 && (touchDown || touchUp)) {
+        const wasHeld = heldKnobs.has(key);
+        if (touchUp) {
+            heldKnobs.delete(key);
+            if (ownedKnobs.delete(key)) return true;
+            return clipsPanelActive() && clipsPage === 1;
+        }
+        heldKnobs.add(key);
+        if (!clipsPanelActive()) return false;
+        if (clipsPage === 1 || clipsKnobTrack() >= 0) {
+            ownedKnobs.add(key);
+            if (clipsPage === 0 && !wasHeld) {
+                momentaryGesture();
+                sessionLaunchCell(clipsKnobTrack(), key);
+            }
+            appState.dirty = true;
+            return true;
+        }
+        // Normal keeps the existing Master controls and reveals their values.
+        setClipsPage(2);
+    }
+    if (!clipsSurfaceActive() || status !== 176) return false;
+    if (key === 62 || key === 63) {
+        if (value && focusGroupStep(key === 63 ? 1 : -1)) appState.dirty = true;
+        return true;
+    }
+    if (key >= 71 && key <= 78 && clipsPage < 2) {
+        if (clipsPage === 1) turnClipsSetting(key - 71, value < 64 ? value : value - 128);
+        if (clipsPage === 1 || clipsKnobTrack() >= 0) return true;
+        setClipsPage(2);
+        return false;
+    }
+    if (key === 14 && !loopHeld() && value !== 0) {
+        const direction = value < 64 ? 1 : -1;
+        if (clipsPage < 2) {
+            setClipsPage(clipsPage + direction);
+            if (clipsPage === 2) { appState.masterChainIndex = 0; appState.masterDetail = false; }
+            return true;
+        }
+        if (direction < 0 && !appState.masterDetail && appState.masterChainIndex === 0) {
+            setClipsPage(1); return true;
+        }
+    }
+    if (key === MoveMainButton && clipsPage < 2) {
+        if (value) setClipsPage(clipsPage === 0 ? 1 : 0);
+        return true;
+    }
+    if (key === 51) {
+        if (clipsPage === 1 || (clipsPage === 2 && !appState.masterDetail)) {
+            if (value) setClipsPage(0);
+            return true;
+        }
+    }
+    return false;
+}
+
+/** Engine status only; no reads from hosted chains during drawing. */
+export function clipsSlotStatus(track: number, slot: number): string {
+    const state = seqState.session[track];
+    return state.queued === slot ? 'Q' : state.playing === slot ? 'P'
+        : state.selected === slot ? 'S' : (state.exist & (1 << slot)) ? '+' : '-';
+}
+export function renderClipsKnobs(): void {
+    const track = clipsKnobTrack();
+    const colors = Array.from({length: 8}, (_, slot) => {
+        if (clipsPage === 1) return slot < 3 ? 120 : 0;
+        if (track < 0) return 0;
+        const state = seqState.session[track];
+        return state.queued === slot ? 120 : sessionCellColor({track,
+            exists: !!(state.exist & (1 << slot)), isSel: state.selected === slot,
+            isPlaying: state.playing === slot, isQueued: false, muted: seqState.muted[track]}).base;
+    });
+    updatePerformanceKnobLEDs(colors);
+}
+export function renderClips(): void {
+    const layout = clipsSnapshot();
+    const bank = appState.focusGroup;
+    clear_screen();
+    drawHeader(clipsPage === 1 ? 'Clips Setup' : 'Clips', `Bank ${bank + 1}/4${seqState.recording ? ' REC' : ''}`);
+    const line = (y: number, text: string): void => fontPrint(2, y, fitHeaderText(text, 124), 1);
+    if (clipsPage === 1) {
+        line(12, '1 Row: ' + ['Bank', 'Conductor', 'Drums'][layout.topRow]);
+        line(22, '2 Touch: ' + ['Normal', 'Conductor', 'Drums'][layout.knobRow]);
+        line(32, '3 Drum track: ' + (layout.drumTracks[bank] + 1));
+        line(43, 'Launch: bar / stopped now');
+        line(51, 'Tap playing: relaunch');
+        line(58, 'Jog > Master / Back');
+    } else {
+        line(12, 'Pads: ' + [3, 2, 1, 0].map(row => clipsRowTrack(row) + 1).join('/'));
+        const track = clipsKnobTrack();
+        line(22, track < 0 ? 'Knobs: Master controls' : `${layout.knobRow === 1 ? 'Conductor' : 'Drums'} ${track + 1} - Touch clips`);
+        if (track >= 0) for (let slot = 0; slot < 8; slot++) {
+            fontPrint(slot * 16 + 2, 33, String(slot + 1), 1);
+            fontPrint(slot * 16 + 2, 42, clipsSlotStatus(track, slot), 1);
+        }
+        line(50, 'L/R: Bank | P:Play Q:Queue');
+        line(58, 'Jog > Setup > Master');
+    }
+}
