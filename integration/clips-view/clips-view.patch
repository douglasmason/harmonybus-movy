+/** Presentation only: no chain-role, transport or scene mutations. */
+import { appState } from '../app/state.js';
+import { markUiStateDirty } from './ui-dirty.js';
+
+export interface ClipsLayout {
+    topRow: number; // 0: native bank, 1: conductor, 2: drums
+    knobRow: number; // 0: normal, 1: conductor, 2: drums
+    drumTracks: number[];
+}
+const defaults = (): ClipsLayout => ({ topRow: 0, knobRow: 0, drumTracks: [4, 4, 8, 12] });
+let layout: ClipsLayout = defaults();
+export let clipsPage = 0; // performance, settings, existing Master pipeline
+export function enterClips(): void { clipsPage = 0; appState.masterDetail = false; }
+export function setClipsPage(page: number): void {
+    clipsPage = Math.max(0, Math.min(2, page));
+    appState.dirty = true;
+}
+export function clipsSnapshot(): ClipsLayout { return { ...layout, drumTracks: [...layout.drumTracks] }; }
+export function restoreClips(value: unknown): void {
+    layout = defaults();
+    if (value && typeof value === 'object') {
+        const saved = value as Partial<ClipsLayout>;
+        for (const key of ['topRow', 'knobRow'] as const)
+            if (Number.isInteger(saved[key]) && saved[key]! >= 0 && saved[key]! <= 2) layout[key] = saved[key]!;
+        if (Array.isArray(saved.drumTracks)) saved.drumTracks.slice(0, 4).forEach((track, bank) => {
+            if ([4, 8, 12].includes(track)) layout.drumTracks[bank] = track;
+        });
+    }
+    enterClips();
+}
+export function clipsRoleTrack(role: number, bank = appState.focusGroup): number {
+    return role === 1 ? 0 : role === 2 ? layout.drumTracks[bank] : -1;
+}
+export function clipsRowTrack(rowFromBottom: number): number {
+    const bankRow = 3 - rowFromBottom;
+    return bankRow === 0 && layout.topRow ? clipsRoleTrack(layout.topRow) : appState.focusGroup * 4 + bankRow;
+}
+export function clipsKnobTrack(): number { return clipsRoleTrack(layout.knobRow); }
+export function turnClipsSetting(knob: number, delta: number): void {
+    if (!delta || knob < 0 || knob > 2) return;
+    const direction = Math.sign(delta);
+    if (knob < 2) {
+        const key = knob === 0 ? 'topRow' : 'knobRow';
+        layout[key] = Math.max(0, Math.min(2, layout[key] + direction));
+    } else {
+        const tracks = [4, 8, 12];
+        const bank = appState.focusGroup;
+        layout.drumTracks[bank] = tracks[Math.max(0, Math.min(2, tracks.indexOf(layout.drumTracks[bank]) + direction))];
+    }
+    markUiStateDirty(); appState.dirty = true;
+}
