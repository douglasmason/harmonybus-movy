diff --git a/engine/crates/movy-dsp/src/drum_output.rs b/engine/crates/movy-dsp/src/drum_output.rs
new file mode 100644
index 00000000..8d1dd26a
--- /dev/null
+++ b/engine/crates/movy-dsp/src/drum_output.rs
@@ -0,0 +1,30 @@
+//! Shared channel-1 percussion ownership. Scheduling remains in seq-core.
+pub struct Output { held: [u16;128] }
+impl Default for Output { fn default()->Self {Self{held:[0;128]}} }
+impl Output {
+    pub fn send(&mut self,status:u8,pitch:u8,value:u8,mut emit:impl FnMut(u8,u8,u8)) {
+        let owners=&mut self.held[pitch as usize];
+        match status {
+            0x90 => {
+                // Retrigger the same sample, including simultaneous independent clips.
+                // Close its physical gate first; a shorter overlapping owner cannot
+                // later release a hit still owned by another source.
+                if *owners>0 {emit(0x80,pitch,0);}
+                *owners=owners.saturating_add(1);emit(0x90,pitch,value);
+            },
+            0x80 if *owners>0 => {*owners-=1;if *owners==0 {emit(0x80,pitch,0);}},
+            0xa0 if *owners>0 => emit(0xa0,pitch,value),
+            _=>{}
+        }
+    }
+}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn overlapping_clips_retrigger_and_last_owner_releases() {
+        let mut output=Output::default();let mut events=Vec::new();
+        for (status,value) in [(0x90,100),(0x90,80),(0x80,0),(0xa0,55),(0x80,0),(0x80,0)] {
+            output.send(status,38,value,|status,pitch,value|events.push((status,pitch,value)));
+        }
+        assert_eq!(events,vec![(0x90,38,100),(0x80,38,0),(0x90,38,80),(0xa0,38,55),(0x80,38,0)]);
+    }
+}
