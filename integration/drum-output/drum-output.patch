+/** Clip-only routing: engine persistence and Undo own the actual destination. */
+import {appState} from '../app/state.js';
+import {seqState} from './state.js';
+import {clipsSnapshot} from './clips-layout.js';
+import {engineReady,seqCmdFlush} from './engine.js';
+import {undoableEdit} from '../undo/edit.js';
+import {seqEdit} from '../undo/record.js';
+import {seqToast} from './render.js';
+export function drumOutputTrack():number {return clipsSnapshot().drumTracks[appState.focusGroup];}
+export function drumOutputLabel():string {return seqState.drumOutputs&(1<<drumOutputTrack())?'Drum Ch 1':'Chain';}
+export function turnDrumOutput(delta:number):void {
+    if(!delta||!engineReady())return;
+    const track=drumOutputTrack(),enabled=delta>0;
+    if(enabled===!!(seqState.drumOutputs&(1<<track)))return;
+    if(enabled) {
+        const route=host_module_get_param('source_route_'+track)?.trim().split(/\s+/);
+        if(route?.[1]==='1'){seqToast('Disable Source Weaving first');return;}
+    }
+    undoableEdit('DRUM CLIP OUT','Track '+(track+1),()=>seqEdit('drumout '+track+' '+Number(enabled)));
+    seqCmdFlush();
+    if(enabled)seqState.drumOutputs|=1<<track;else seqState.drumOutputs&=~(1<<track);
+    appState.dirty=true;
+}
