+#[cfg(test)] mod drum_destination_tests {
+    use super::*;
+    use crate::{command::apply_batch,persist};
+    fn fixture(track:usize)->Engine {
+        let mut engine=Engine::new(44100,12000);
+        engine.link_enabled=false;
+        engine.tracks[track].active_mut().set_loop(0,16);
+        engine.tracks[track].active_mut().toggle_step(0,&[(38,101)]);
+        engine.tracks[track].active_mut().notes[0].gate=200;
+        engine.tracks[track].active_mut().notes[0].pressure=vec![(0,30),(2,77)];
+        engine.tracks[track].active_mut().transpose=12;
+        engine
+    }
+    #[test] fn destinations_preserve_samples_and_onset_owned_releases() {
+        for track in [4,8,12] {for rendered in [false,true] {
+            let mut engine=fixture(track);let mut output=Vec::new();
+            engine.tracks[track].active_mut().notes[0].rendered=rendered;
+            engine.tracks[track].active_mut().notes[0].input_key=Some(crate::follower_input::InputKey{root:0,scale:0,transpose:0});
+            assert!(engine.set_drum_output(track,true,&mut output));
+            engine.set_track_drum(track,false); // Later synth identity cannot cancel explicit routing.
+            engine.play();engine.step_tick(track,&mut output);
+            assert!(output.contains(&OutEvent::DrumMidi{status:0x90,pitch:38,value:101}));
+            assert!(output.contains(&OutEvent::DrumMidi{status:0xa0,pitch:38,value:30}));
+            assert!(!output.iter().any(|event|matches!(event,OutEvent::NoteOn{..}|OutEvent::RenderedOn{..}|OutEvent::RecordedActions{..}|OutEvent::InputRole{..})));
+            output.clear();engine.step_tick(track,&mut output);engine.step_tick(track,&mut output);
+            assert!(output.contains(&OutEvent::DrumMidi{status:0xa0,pitch:38,value:77}));
+            output.clear();assert!(engine.set_drum_output(track,false,&mut output));
+            assert_eq!(output.iter().filter(|event|matches!(event,OutEvent::DrumMidi{status:0x80,pitch:38,..})).count(),1);
+            output.clear();engine.stop(&mut output);
+            assert!(!output.iter().any(|event|matches!(event,OutEvent::DrumMidi{..})));
+            assert_eq!(engine.tracks[track].active().notes[0].pitch,38);
+        }}
+    }
+    #[test] fn legacy_load_invalid_routes_and_undo_are_safe() {
+        let mut engine=fixture(4);let mut output=Vec::new();
+        let original=persist::serialize(&engine);
+        apply_batch(&mut engine,"usnap 1;drumout 4 1;drumout 8 1;drumout 12 1",&mut output);
+        let saved=persist::serialize(&engine);assert_eq!(engine.drum_outputs,0x1110);
+        for track in [0,1,3,5,15,16,usize::MAX] {assert!(!engine.set_drum_output(track,true,&mut output));}
+        let mut restored=Engine::new(44100,12000);assert!(persist::load(&mut restored,&saved));assert_eq!(restored.drum_outputs,0x1110);
+        apply_batch(&mut engine,"uswap 1 2",&mut output);assert_eq!(engine.drum_outputs,0);
+        apply_batch(&mut engine,"uswap 2 3",&mut output);assert_eq!(engine.drum_outputs,0x1110);
+        assert!(persist::load(&mut restored,&original));assert_eq!(restored.drum_outputs,0);
+        assert!(restored.source_route_set("4 1 -1 -1 -1 -1 0"));
+        assert!(!restored.set_drum_output(4,true,&mut output));
+        assert!(restored.set_drum_output(8,true,&mut output));
+        assert!(!restored.source_route_set("8 1 -1 -1 -1 -1 0"));
+    }
+    #[test] fn stop_mute_scene_and_undo_release_the_drum_destination() {
+        for command in ["stop","mute 4 1","stoptrk 4","uswap 1 2"] {
+            let mut engine=fixture(4);let mut output=Vec::new();
+            apply_batch(&mut engine,"usnap 1;drumout 4 1",&mut output);
+            engine.play();engine.step_tick(4,&mut output);output.clear();
+            apply_batch(&mut engine,command,&mut output);
+            if command.starts_with("stoptrk") {for _ in 0..800 {engine.advance_block(128,&mut output);}}
+            assert!(output.contains(&OutEvent::DrumMidi{status:0x80,pitch:38,value:0}),"{command}: {output:?}");
+        }
+    }
