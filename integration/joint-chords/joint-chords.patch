diff --git a/engine/crates/seq-core/src/chord_step.rs b/engine/crates/seq-core/src/chord_step.rs
new file mode 100644
--- /dev/null
+++ b/engine/crates/seq-core/src/chord_step.rs
@@ -0,0 +1,58 @@
+// Step entry stores the same immutable descriptor captured by live recording.
+impl Engine {
+    pub fn chord_step_input_status(&self)->String {
+        self.chord_step_input.map_or_else(||"--".into(),|(serial,track,pitch,_)|format!("{serial},{track},{pitch}"))
+    }
+    pub fn chord_step_add(&mut self,track:usize,slot:usize,step:u32,serial:u32){
+        if self.playing||self.recording||self.count_in_left>0||self.pending_rec||step>=256||track>=self.tracks.len(){return;}
+        let Some((captured,owner,pitch,actions))=self.chord_step_input else{return;};
+        if serial!=captured||track!=owner||self.tracks[track].active_clip!=slot{return;}
+        let clip=self.tracks[track].active_mut();
+        let stored=(pitch as i16-clip.transpose as i16).clamp(0,127) as u8;
+        clip.delete_range(step as u16,step as u16,None);
+        clip.add_pitch_range(step as u16,step as u16,stored,100,false);
+        if let Some(note)=clip.notes.iter_mut().find(|note|note.step==step as u16&&note.pitch==stored){note.actions=Some(actions);note.input_key=None;note.rendered=false;}
+    }
+}
+
+#[cfg(test)]mod chord_step_tests {
+    use super::*;
+    use crate::{command::apply_batch,persist,recorded_actions};
+    fn capture(engine:&mut Engine,track:usize,pitch:u8)->u32 {
+        let mut actions=[0;recorded_actions::LANES+1];actions[0]=0xc858001f00000000|0x91|(0xab5<<12);
+        engine.recorded_action(track,&format!("ra4,{}",recorded_actions::payload(pitch,actions)));
+        engine.chord_step_input.unwrap().0
+    }
+    #[test]fn semantic_chord_step_tie_rest_and_save_roundtrip(){
+        let mut engine=Engine::new(48000,12000);let mut out=Vec::new();
+        apply_batch(&mut engine,"addp 3 0 0 72 90;addp 0 0 0 65 80;addp 0 2 2 67 80",&mut out);
+        let melody=engine.tracks[3].active().clone();let serial=capture(&mut engine,0,60);
+        // This consumes the normal recording cache, exactly as the host input path does.
+        engine.live_note_on(0,60,100);assert!(engine.record_actions[0][60].is_none());
+        apply_batch(&mut engine,&format!("cadd 0 0 0 {serial};slen 0 0 0 60 48;del 0 2 2 -1"),&mut out);
+        let clip=engine.tracks[0].active();assert_eq!(clip.notes.len(),1);
+        let note=&clip.notes[0];assert_eq!((note.step,note.pitch,note.gate),(0,60,48));
+        assert!(recorded_actions::chord_selection(&note.actions.unwrap()));assert!(!note.rendered);assert!(note.input_key.is_none());
+        assert_eq!(engine.tracks[3].active().notes.len(),melody.notes.len());assert_eq!(engine.tracks[3].active().notes[0].pitch,72);
+        let saved=persist::serialize(&engine);let mut restored=Engine::new(48000,12000);assert!(persist::load(&mut restored,&saved));
+        assert_eq!(restored.tracks[0].active().notes[0].actions,engine.tracks[0].active().notes[0].actions);
+        assert_eq!(restored.tracks[0].active().notes[0].gate,48);assert!(restored.chord_step_input.is_none());
+    }
+    #[test]fn invalid_and_stale_chord_entry_never_clears_the_step(){
+        let mut engine=Engine::new(48000,12000);let mut out=Vec::new();
+        apply_batch(&mut engine,"addp 0 0 0 65 80",&mut out);let serial=capture(&mut engine,0,60);
+        for command in [format!("cadd 0 0 0 {}",serial+1),format!("cadd 1 0 0 {serial}"),format!("cadd 0 1 0 {serial}"),format!("cadd 0 0 256 {serial}"),"cadd 0 0 0".into()] {
+            apply_batch(&mut engine,&command,&mut out);assert_eq!(engine.tracks[0].active().notes[0].pitch,65);
+        }
+        engine.playing=true;apply_batch(&mut engine,&format!("cadd 0 0 0 {serial}"),&mut out);assert_eq!(engine.tracks[0].active().notes[0].pitch,65);
+        engine.playing=false;engine.recording=true;apply_batch(&mut engine,&format!("cadd 0 0 0 {serial}"),&mut out);assert_eq!(engine.tracks[0].active().notes[0].pitch,65);
+    }
+    #[test]fn chord_step_undo_restores_full_descriptor_and_previous_notes(){
+        let mut engine=Engine::new(48000,12000);let mut out=Vec::new();
+        apply_batch(&mut engine,"addp 0 0 0 65 80;usnap 99",&mut out);let serial=capture(&mut engine,0,60);
+        apply_batch(&mut engine,&format!("cadd 0 0 0 {serial};ucommit 99"),&mut out);
+        assert!(engine.tracks[0].active().notes[0].actions.is_some());
+        apply_batch(&mut engine,"uswap 99 100",&mut out);assert_eq!(engine.tracks[0].active().notes[0].pitch,65);
+        apply_batch(&mut engine,"uswap 100 99",&mut out);assert_eq!(engine.tracks[0].active().notes[0].pitch,60);assert!(engine.tracks[0].active().notes[0].actions.is_some());
+    }
+}
