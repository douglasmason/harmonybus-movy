+/** Performance shortcuts to the existing clip launch and motif import owners. */
+import {TouchSequence} from './touch-sequence.js';
+import {launchClip} from './session.js';
+import {seqCmdFlush,engineReady} from './engine.js';
+import {seqState} from './state.js';
+import {stepRecActive} from './step-rec.js';
+import {seqToast} from './render.js';
+import {markUiStateDirty} from './ui-dirty.js';
+import {appState} from '../app/state.js';
+import {MOTIF_LOAD_CHOICES,previewMotifSequence} from '../renderer/hb-motif-loader.js';
+import type {PerformancePort} from '../renderer/hb-performance.js';
+export interface ConductorContent {clips:number[];motifs:number[];}
+const motifChoices=[...MOTIF_LOAD_CHOICES,'Rest','Tie'];
+const phrase=new TouchSequence<string>();
+let phraseOwner:{port:PerformancePort;isCurrent:()=>boolean;release:()=>void}|null=null;
+const fresh=():ConductorContent=>({clips:Array.from({length:7},(_,i)=>i),motifs:[0,1,2,3,4,MOTIF_LOAD_CHOICES.length,MOTIF_LOAD_CHOICES.length+1]});
+let content=fresh();
+const clipChoices=Array.from({length:8},(_,i)=>'Clip '+(i+1));
+const match=(key:string):RegExpExecArray|null=>/^cp_(clip|motif)_launch_([0-6])$/.exec(key);
+export function conductorContentSnapshot():ConductorContent{return {clips:[...content.clips],motifs:[...content.motifs]};}
+export function restoreConductorContent(saved:unknown):void {
+    content=fresh();if(!saved||typeof saved!=='object')return;
+    for(const kind of ['clips','motifs'] as const){const values=(saved as Partial<ConductorContent>)[kind];if(Array.isArray(values))values.slice(0,7).forEach((value,index)=>{if(Number.isInteger(value)&&value>=0&&value<(kind==='clips'?8:motifChoices.length))content[kind][index]=value;});}
+}
+export function conductorContentParameters():any[]{return ['clip','motif'].flatMap(kind=>Array.from({length:7},(_,index)=>({key:`cp_${kind}_launch_${index}`,name:(kind==='clip'?'Clip ':'Motif ')+(index+1),type:'enum',options_as_string:true,options:kind==='clip'?clipChoices:motifChoices,default:(kind==='clip'?clipChoices:motifChoices)[index]})));}
+export function conductorContentRead(key:string):string|null {const found=match(key);if(!found)return null;const [kind,index]=[found[1],Number(found[2])];return kind==='clip'?clipChoices[content.clips[index]]:motifChoices[content.motifs[index]];}
+export function conductorContentWrite(key:string,value:string):boolean|null {
+    const found=match(key);if(!found)return null;
+    const kind=found[1]==='clip'?'clips':'motifs',index=(kind==='clips'?clipChoices:motifChoices).indexOf(value);
+    if(index<0)return false;if(kind==='motifs')phrase.invalidate();content[kind][Number(found[2])]=index;markUiStateDirty();appState.dirty=true;return true;
+}
+export function conductorContentColor(key:string,track:number):number|null {
+    const found=match(key);if(!found)return null;if(found[1]==='motif'){const index=Number(found[2]);return phrase.owns(index)||phrase.owns(16+index)||phrase.owns(24+index)?120:motifChoices[content.motifs[index]]==='Tie'&&!phrase.active?0:123;}
+    const slot=content.clips[Number(found[2])],state=seqState.session[track];
+    return state.queued===slot?7:state.playing===slot?120:state.exist&(1<<slot)?123:1;
+}
+export function activateConductorContent(key:string,owner:PerformancePort,isCurrent:()=>boolean,release:()=>void):boolean {
+    const found=match(key),track=owner.performanceTrack;if(!found||track===undefined)return false;
+    if(!isCurrent()||!engineReady())return true;
+    if(stepRecActive()){seqToast('Finish step entry first');return true;}
+    const go=(slot:number):void=>{release();launchClip(track,slot,false);seqCmdFlush();seqToast('Conductor Clip '+(slot+1));};
+    const index=Number(found[2]);
+    if(found[1]==='clip')go(content.clips[index]);
+    else previewMotifSequence(owner,[motifChoices[content.motifs[index]]],isCurrent,(_track,slot)=>go(slot));
+    return true;
+}
+
+export function conductorPhraseTurn(control:number):void {if(phrase.owns(control))phrase.invalidate();}
+export function cancelConductorPhrase():void {phrase.cancel();phraseOwner=null;}
+export function conductorPhraseTouch(key:string,control:number,down:boolean,owner?:PerformancePort,isCurrent?:()=>boolean,release?:()=>void):boolean {
+    if(!down){
+        if(!phrase.owns(control))return false;
+        const values=phrase.release(control);appState.dirty=true;
+        if(values===null)return true;
+        const context=phraseOwner;phraseOwner=null;
+        if(values.length&&context?.isCurrent())previewMotifSequence(context.port,values,context.isCurrent,(track,slot)=>{context.release();launchClip(track,slot,false);seqCmdFlush();seqToast('Conductor phrase launched');});
+        return true;
+    }
+    const found=match(key);if(!found||found[1]!=='motif')return false;
+    if(!owner||!isCurrent||!release||!isCurrent()||!engineReady())return true;
+    if(stepRecActive()){seqToast('Finish step entry first');return true;}
+    if(!phrase.active)phraseOwner={port:owner,isCurrent,release};
+    const accepted=phrase.begin(control,motifChoices[content.motifs[Number(found[2])]]);
+    seqToast(accepted?'Phrase: '+phrase.length+' / overlap to add':'Phrase limit: 16');appState.dirty=true;return true;
+}
