+import {stepRecDown,stepRecUp,stepRecPad,stepRecPadRelease,stepRecActive,stepRecEnd,stepRecHead} from './step-rec.js';
+import {stepRecClipOwner,setStepRecClipOwner} from './step-rec-owner.js';
+import {stepRecTarget} from './step-rec-target.js';
+import {seqState,requestLoopWindowAdopt} from './state.js';
+import {engineReady,engineGeneration,fieldEngineSet,seqCmdFlush} from './engine.js';
+import {recToggle} from '../undo/rec-pass.js';
+import {seqToast} from './render.js';
+import {appState} from '../app/state.js';
+
+/** Chord choices are another input to the existing clip step recorder. */
+let destination:{track:number;slot:number;generation:number}|null=null;
+export function endChordStepEntry():void {
+    if(stepRecClipOwner()!==null){stepRecEnd();}
+    destination=null;
+}
+export function chordRecordButton(down:boolean,track:number):void {
+    if(down){
+        if(seqState.playing||seqState.recording||seqState.countingIn){recToggle(track);return;}
+        if(stepRecTarget()){seqToast('Finish motif edit first');return;}
+        if(stepRecActive()||!engineReady())return;
+        seqCmdFlush();
+        const clip=String(host_module_get_param('motif_clip_info_'+track)??'').split(',');
+        const slot=Number(clip[0]),length=Number(clip[2]),start=Number(clip[3]);
+        if(clip.length!==6||![slot,length,start].every(Number.isInteger)||slot<0||length<0||length>256){seqToast('Conductor clip unavailable');return;}
+        destination={track,slot,generation:engineGeneration()};
+        const entered=destination;
+        setStepRecClipOwner(track,()=>!seqState.playing&&engineGeneration()===entered.generation&&Number(String(host_module_get_param('motif_clip_info_'+track)??'').split(',')[0])===entered.slot,()=>fieldEngineSet('chord_select','off'));seqState.lenSteps=length;seqState.loopStart=start;seqState.watchLane=-1;seqState.occ.fill(0);
+        stepRecDown();seqToast('Hold Rec: chords / Right: tie or rest');
+    }else{
+        if(stepRecClipOwner()===null)return;
+        const tap=stepRecUp();destination=null;requestLoopWindowAdopt();
+        if(tap)recToggle(track);
+    }
+}
+export function chordStepPress(control:number,track:number,payload:string):boolean {
+    if(stepRecClipOwner()===null)return false;
+    if(!destination||!stepRecActive()||seqState.playing||track!==destination.track||destination.generation!==engineGeneration()){
+        endChordStepEntry();return true;
+    }
+    seqCmdFlush();
+    if(Number(String(host_module_get_param('motif_clip_info_'+track)??'').split(',')[0])!==destination.slot){endChordStepEntry();seqToast('Clip changed');return true;}
+    const before=String(host_module_get_param('chord_step_input')??'');
+    fieldEngineSet('chord_select',payload);
+    const after=String(host_module_get_param('chord_step_input')??'');
+    const [serial,owner,pitch]=after.split(',').map(Number);
+    if(after===before||owner!==track||![serial,pitch].every(Number.isSafeInteger)||pitch<0||pitch>127){seqToast('Chord unavailable');return true;}
+    stepRecPad(control,pitch,100,(step)=>`cadd ${track} ${destination!.slot} ${step} ${serial}`);
+    seqCmdFlush();appState.dirty=true;seqToast('Chord step '+(stepRecHead()+1));return true;
+}
+export function chordStepRelease(control:number):void {
+    if(stepRecClipOwner()===null)return;
+    stepRecPadRelease(control);appState.dirty=true;
+}
