@@ -0,0 +1,23 @@
+/** A connected chain of touches, ordered by onset rather than release. */
+export class TouchSequence<T> {
+    private held=new Set<number>();
+    private values:T[]=[];
+    private invalid=false;
+    constructor(private readonly limit=16){}
+    get length():number{return this.values.length;}
+    get active():boolean{return this.held.size>0;}
+    owns(control:number):boolean{return this.held.has(control);}
+    begin(control:number,value:T):boolean {
+        if(this.held.has(control))return true;
+        if(!this.active){this.values=[];this.invalid=false;}
+        this.held.add(control);
+        if(this.values.length>=this.limit){this.invalid=true;return false;}
+        this.values.push(value);return true;
+    }
+    invalidate():void {if(this.active)this.invalid=true;}
+    release(control:number):T[]|null {
+        if(!this.held.delete(control)||this.active)return null;
+        const result=this.invalid?[]:[...this.values];this.cancel();return result;
+    }
+    cancel():void {this.held.clear();this.values=[];this.invalid=false;}
+}
