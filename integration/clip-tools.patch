+//! Explicit clip edits share the sequencer's quantization and swing timing.
+use crate::clip::Note;
+use crate::engine::Engine;
+use crate::TICKS_PER_STEP;
+
+/// Actual clip-local onset; the same function drives playback and gap lengths.
+pub fn playback_tick(note: &Note, quant: u8, swing: u32, end: u32, span: u32) -> u32 {
+    let anchor = note.step as i64 * TICKS_PER_STEP as i64;
+    let deviation = note.tick as i64 - anchor;
+    let half = if deviation >= 0 { 50 } else { -50 };
+    let pulled = deviation - (deviation * quant.min(100) as i64 + half) / 100;
+    let mut tick = (anchor + pulled + swing as i64).max(0) as u32;
+    if tick >= end { tick -= span.max(1); }
+    tick
+}
+
+impl Engine {
+    /// Grid zero only fills; otherwise snap starts to the nearest chosen grid.
+    /// Only the selected melodic clip's current loop is edited. Trig conditions
+    /// and automation stay attached to their existing step positions.
+    pub fn fill_clip_gaps(&mut self, track: usize, grid: u32) {
+        if track >= self.tracks.len() || self.recording || self.track_is_drum(track)
+            || !matches!(grid, 0 | 24 | 48 | 96 | 192 | 384) { return; }
+        let clip = self.tracks[track].active();
+        let start = clip.loop_start_ticks();
+        let end = clip.loop_end_ticks();
+        if end <= start { return; }
+        // Cache the scaled swing offsets before mutably borrowing the clip.
+        let swing: Vec<u32> = (0..=crate::clip::MAX_STEPS)
+            .map(|step| self.swing_delay(step, clip.scale_num, clip.scale_den)).collect();
+        let clip = self.tracks[track].active_mut();
+        if grid > 0 {
+            for note in &mut clip.notes {
+                if note.tick < start || note.tick >= end || note.vel == 0 { continue; }
+                let snapped = start + ((note.tick - start + grid / 2) / grid) * grid;
+                // Keep the final onset inside this window (never move it into
+                // another clip or wrap it over the first chord).
+                note.tick = snapped.min(start + ((end - start - 1) / grid) * grid);
+                note.step = (note.tick / TICKS_PER_STEP) as u16;
+            }
+        }
+        let onsets: Vec<Option<u32>> = clip.notes.iter().map(|note| {
+            if note.tick < start || note.tick >= end || note.vel == 0 { return None; }
+            Some(playback_tick(note, clip.quant, swing.get(note.step as usize).copied().unwrap_or(0), end, end-start))
+        }).collect();
+        for (index, note) in clip.notes.iter_mut().enumerate() {
+            if let Some(onset) = onsets[index] {
+                let next = onsets.iter().flatten().copied().filter(|other| *other > onset).min().unwrap_or(end);
+                note.gate = next.saturating_sub(onset).max(1);
+            }
+        }
+        // Keep fired/suppress flags: a live edit must not replay this pass.
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn note(tick: u32, pitch: u8) -> Note {
+        Note { tick, gate: 3, pitch, vel: 100, step: ((tick+12)/24) as u16, suppress: false, fired: false }
+    }
+    #[test]
+    fn quantize_then_fill_chords_and_preserve_outside_loop() {
+        let mut engine = Engine::new(48000,12000);
+        let clip = engine.tracks[0].active_mut();
+        clip.length_steps=16;clip.loop_start_steps=16;
+        clip.notes=vec![note(390,60),note(395,64),note(448,62),note(450,66),note(740,67),note(24,72)];
+        engine.fill_clip_gaps(0,48);
+        let notes=&engine.tracks[0].active().notes;
+        assert_eq!(notes.iter().map(|note|note.tick).collect::<Vec<_>>(),vec![384,384,432,432,720,24]);
+        assert_eq!(notes.iter().map(|note|note.gate).collect::<Vec<_>>(),vec![48,48,288,288,48,3]);
+        assert_eq!(notes[1].pitch,64);
+    }
+    #[test]
+    fn fill_uses_quantized_swung_onsets_and_keeps_starts() {
+        let mut engine=Engine::new(48000,12000);
+        engine.swing_pct=80;
+        let clip=engine.tracks[0].active_mut();clip.length_steps=16;clip.quant=100;
+        clip.notes=vec![note(5,60),note(27,62),note(51,64)];
+        engine.fill_clip_gaps(0,0);
+        let notes=&engine.tracks[0].active().notes;
+        assert_eq!(notes.iter().map(|note|note.tick).collect::<Vec<_>>(),vec![5,27,51]);
+        assert_eq!(notes.iter().map(|note|note.gate).collect::<Vec<_>>(),vec![36,12,336]);
+    }
+    #[test]
+    fn command_is_one_undoable_persisted_edit() {
+        let mut engine=Engine::new(48000,12000);
+        let clip=engine.tracks[0].active_mut();clip.length_steps=16;
+        clip.notes=vec![note(5,60),note(52,62)];
+        let before=engine.undo_snapshot();
+        let mut output=Vec::new();
+        crate::command::apply_batch(&mut engine,"usnap 17;cfill 0 48;ucommit 17",&mut output);
+        assert_eq!(engine.tracks[0].active().notes[0].gate,48);
+        let saved=crate::persist::serialize(&engine);
+        let mut restored=Engine::new(48000,12000);
+        assert!(crate::persist::load(&mut restored,&saved));
+        assert_eq!(restored.tracks[0].active().notes[0].gate,48);
+        crate::command::apply_batch(&mut engine,"uswap 17 18",&mut output);
+        assert_eq!(engine.undo_snapshot(),before);
+    }
+    #[test]
+    fn empty_recording_and_drums_are_safe_noops() {
+        let mut engine=Engine::new(48000,12000);engine.fill_clip_gaps(0,48);
+        let clip=engine.tracks[0].active_mut();clip.length_steps=16;clip.notes=vec![note(5,60)];
+        engine.set_track_drum(0,true);engine.fill_clip_gaps(0,48);
+        assert_eq!(engine.tracks[0].active().notes[0].tick,5);
+        engine.set_track_drum(0,false);engine.recording=true;engine.fill_clip_gaps(0,48);
+        assert_eq!(engine.tracks[0].active().notes[0].tick,5);
+    }
+}
