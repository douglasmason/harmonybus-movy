diff --git a/engine/crates/seq-core/src/song_participation.rs b/engine/crates/seq-core/src/song_participation.rs
new file mode 100644
index 00000000..35f52414
--- /dev/null
+++ b/engine/crates/seq-core/src/song_participation.rs
@@ -0,0 +1,31 @@
+// Musical rests reuse the existing clip-emission and gate owner. Source
+// availability is still determined by playback, never by this output policy.
+impl Engine {
+    fn song_clip_rest(&self, track: usize) -> bool {
+        self.song_shape_active()
+            && self.song_sections[&self.song_pos].rest_mask & (1 << track) != 0
+            && self.follower_inputs[track].is_some()
+            && !(self.recording && self.records_track(track))
+    }
+
+    /// Strict optional sp1 line; its ss1 recipe must already exist.
+    pub fn song_participation_set(&mut self, message: &str) -> bool {
+        let fields: Vec<_> = message.split_whitespace().collect();
+        let [index, mask] = fields.as_slice() else { return false; };
+        let (Ok(index), Ok(mask)) = (index.parse::<usize>(), mask.parse::<u16>()) else { return false; };
+        let Some(section) = self.song_sections.get_mut(&index) else { return false; };
+        section.rest_mask = mask;
+        true
+    }
+
+    pub fn song_participation_message(&self, index: usize) -> Option<String> {
+        self.song.get(index)?;
+        Some(format!("{} {}", index, self.song_sections.get(&index).map_or(0, |section|section.rest_mask)))
+    }
+
+    fn song_participation_snapshot(&self) -> String {
+        let target = self.song_sections.get(&self.song_pos).map_or(0, |section|section.rest_mask);
+        let effective = (0..NUM_TRACKS).fold(0u16, |mask,track|mask | if self.song_clip_rest(track) {1 << track} else {0});
+        format!("{{\"scope\":\"follower-clips\",\"target_rest_mask\":{},\"effective_rest_mask\":{}}}",target,effective)
+    }
+}
diff --git a/engine/crates/seq-core/src/song_participation_tests.rs b/engine/crates/seq-core/src/song_participation_tests.rs
new file mode 100644
index 00000000..89b916be
--- /dev/null
+++ b/engine/crates/seq-core/src/song_participation_tests.rs
@@ -0,0 +1,152 @@
+#[cfg(test)]
+mod song_participation_tests {
+    use super::*;
+    use crate::{command::apply_batch,persist};
+
+    fn fixture() -> Engine {
+        let mut engine=Engine::new(48000,12000);
+        for track in 0..4 {
+            engine.tracks[track].clips[0].set_loop(0,48);
+            for tick in (0..1152).step_by(24) {
+                engine.tracks[track].clips[0].add_note_raw((tick/24) as u16,tick,18,60+track as u8,90);
+            }
+        }
+        engine.follower_input_context("fic1,0,1,14");
+        engine.song=vec![0];engine.song_section_edit("0 bars 1");
+        engine
+    }
+
+    fn trace(engine: &mut Engine, ticks: usize) -> Vec<(usize,u8,u8,u8,bool)> {
+        let mut trace=Vec::new();
+        for tick in 0..ticks {
+            let mut events=Vec::new();engine.advance_block(250,&mut events);
+            for event in events {
+                match event {
+                    OutEvent::NoteOn{track,pitch,vel}|OutEvent::RenderedOn{track,pitch,vel}=>trace.push((tick,track,pitch,vel,true)),
+                    OutEvent::NoteOff{track,pitch}|OutEvent::RenderedOff{track,pitch}=>trace.push((tick,track,pitch,0,false)),
+                    _=>{},
+                }
+            }
+        }
+        trace.sort_unstable();trace
+    }
+
+    #[test]
+    fn normal_is_exact_and_resting_donor_keeps_serving_another_actor() {
+        let mut plain=fixture();let mut resting=fixture();
+        for engine in [&mut plain,&mut resting] {assert!(engine.source_route_set("2 1 1 0 -1 -1 0"));}
+        resting.song_section_edit("0 sound 1 1");
+        let saved=persist::serialize(&resting);
+        plain.play();resting.play();
+        let expected=trace(&mut plain,800);let actual=trace(&mut resting,800);
+        assert!(!actual.iter().any(|event|event.1==1));
+        assert!(actual.iter().any(|event|event.1==2&&event.4));
+        assert_eq!(actual,expected.into_iter().filter(|event|event.1!=1).collect::<Vec<_>>());
+        for track in 0..4 {
+            assert_eq!((resting.tracks[track].pos_tick,resting.tracks[track].cycle),(plain.tracks[track].pos_tick,plain.tracks[track].cycle));
+            assert_eq!(resting.tracks[track].playing_slot,Some(0));
+        }
+        resting.stop(&mut Vec::new());assert!(resting.gates.is_empty());
+        assert_eq!(persist::serialize(&resting),saved);
+        let mut explicit=fixture();let mut baseline=fixture();
+        explicit.song_section_edit("0 sound 1 0");
+        explicit.play();baseline.play();assert_eq!(trace(&mut explicit,400),trace(&mut baseline,400));
+    }
+
+    #[test]
+    fn boundary_releases_only_clip_gates_and_normal_reenters_at_donor_phase() {
+        let mut engine=fixture();
+        engine.tracks[1].clips[0].notes.clear();
+        engine.tracks[1].clips[0].add_note_raw(0,0,1000,60,90);
+        engine.tracks[1].clips[0].add_note_raw(17,408,48,62,90);
+        engine.tracks[1].clips[0].add_note_raw(33,792,48,64,90);
+        engine.song=vec![0,0,0];
+        for index in 0..3 {
+            engine.song_section_edit(&format!("{index} bars 1"));
+            for track in 0..4 {engine.song_section_edit(&format!("{index} track {track} 1"));}
+        }
+        engine.song_section_edit("1 sound 1 1");engine.play();
+        let events=trace(&mut engine,900);
+        assert_eq!(events.into_iter().filter(|event|event.1==1).collect::<Vec<_>>(),vec![
+            (0,1,60,90,true),(384,1,60,0,false),(792,1,64,90,true),(840,1,64,0,false)]);
+        assert_eq!(engine.tracks[1].pos_tick,900);
+        assert_eq!(engine.tracks[1].cycle,1);
+        assert!(engine.gates.iter().all(|gate|gate.track!=1));
+    }
+
+    #[test]
+    fn conductor_rendered_recording_and_live_capture_remain_available() {
+        let mut plain=fixture();let mut resting=fixture();
+        resting.song_participation_set("0 65535");
+        for engine in [&mut plain,&mut resting] {
+            for note in &mut engine.tracks[2].clips[0].notes {note.rendered=true;}
+            engine.play();engine.recording=true;engine.rec_track=1;
+        }
+        let expected=trace(&mut plain,400);let actual=trace(&mut resting,400);
+        assert_eq!(actual,expected.into_iter().filter(|event|event.1!=3).collect::<Vec<_>>());
+        for engine in [&mut plain,&mut resting] {
+            engine.live_note_on(1,72,73);trace(engine,12);engine.live_note_off(1,72);
+            let note=engine.tracks[1].clips[0].notes.iter().find(|note|note.pitch==72).unwrap();
+            assert_eq!((note.vel,note.gate),(73,12));
+        }
+    }
+
+    #[test]
+    fn scaled_donor_clock_and_automation_are_not_muted() {
+        let mut plain=fixture();let mut resting=fixture();
+        for engine in [&mut plain,&mut resting] {
+            engine.tracks[1].clips[0].scale_num=2;engine.tracks[1].clips[0].scale_den=3;
+            apply_batch(engine,"alabel 1 0 synth:cutoff;abase 1 0 20;aset 1 0 0 37;aset 1 0 8 84",&mut Vec::new());
+        }
+        resting.song_section_edit("0 sound 1 1");plain.play();resting.play();
+        let mut expected=Vec::new();let mut actual=Vec::new();
+        for _ in 0..800 {
+            let mut events=Vec::new();plain.advance_block(250,&mut events);
+            expected.extend(events.into_iter().filter(|event|!matches!(event,OutEvent::NoteOn{track:1,..}|OutEvent::NoteOff{track:1,..}|OutEvent::InputRole{track:1,..}|OutEvent::RecordedActions{track:1,..})));
+            resting.advance_block(250,&mut actual);
+        }
+        // Other gate releases may change order at the same tick; automation is
+        // compared separately to avoid making vector ordering a musical contract.
+        let automation=|events:Vec<OutEvent>|events.into_iter().filter_map(|event|match event {OutEvent::Cc{track,lane,val}=>Some((track,lane,val)),_=>None}).collect::<Vec<_>>();
+        let expected=automation(expected);assert!(!expected.is_empty());
+        assert_eq!(automation(actual),expected);
+        assert_eq!((resting.tracks[1].pos_tick,resting.tracks[1].scale_acc),(plain.tracks[1].pos_tick,plain.tracks[1].scale_acc));
+    }
+
+    #[test]
+    fn persistence_undo_and_strict_stopped_edits_preserve_other_recipe_fields() {
+        let mut engine=fixture();
+        apply_batch(&mut engine,"songsection 0 energy 40;songsection 0 sound 1 1;songsection 0 sound 15 1",&mut Vec::new());
+        let saved=persist::serialize(&engine);assert!(saved.contains("sp1 0 32770\n"));
+        let mut restored=fixture();assert!(persist::load(&mut restored,&saved));
+        assert_eq!(persist::serialize(&restored),saved);
+        apply_batch(&mut engine,"usnap 1;songsection 0 sound 1 0;uswap 1 2",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].rest_mask,32770);
+        assert_eq!(engine.song_sections[&0].shape.energy,40);
+        for command in ["0 sound 16 1","0 sound 1 2","0 sound -1 0","0 sound 1 0 junk"] {assert!(!engine.song_section_edit(command));}
+        for message in ["0 -1","0 65536","0 2 junk","9 1"] {assert!(!engine.song_participation_set(message));}
+        engine.pending_play=true;
+        apply_batch(&mut engine,"songsection 0 sound 1 0",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].rest_mask,32770);
+        engine.pending_play=false;engine.play();
+        apply_batch(&mut engine,"songsection 0 sound 1 0",&mut Vec::new());
+        assert_eq!(engine.song_sections[&0].rest_mask,32770);
+        assert!(persist::load(&mut engine,"movy1\nsg 0\nss1 0 1 0000000000000000\nsh1 0 40 20\n"));
+        assert_eq!(engine.song_sections[&0].rest_mask,0);
+    }
+
+    #[test]
+    fn observations_distinguish_target_eligibility_and_stop_without_side_effects() {
+        let mut engine=fixture();engine.song_participation_set("0 15");
+        assert!(engine.song_section_snapshot().contains("\"effective_rest_mask\":0"));
+        engine.play();trace(&mut engine,1);
+        assert!(engine.song_section_snapshot().contains("\"target_rest_mask\":15,\"effective_rest_mask\":14"));
+        let snapshot=engine.song_section_snapshot();let tick=engine.master_tick;
+        for _ in 0..100 {assert_eq!(engine.song_section_snapshot(),snapshot);}
+        assert_eq!(engine.master_tick,tick);
+        engine.recording=true;engine.rec_track=1;
+        assert!(engine.song_section_snapshot().contains("\"effective_rest_mask\":12"));
+        engine.stop(&mut Vec::new());assert!(engine.song_section_snapshot().contains("\"effective_rest_mask\":0"));
+        engine.launch_clip(1,0);assert_eq!(engine.song_participation_message(0),None);
+    }
+}
