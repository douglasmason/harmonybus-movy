new file mode 100644
index 00000000..fa282eb6
--- /dev/null
+++ b/engine/crates/seq-core/src/song_sections.rs
@@ -0,0 +1,155 @@
+// Song recipes extend the existing raw press list and launch queue.
+// Included in engine.rs so runtime observations use the scheduler's own state.
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum SectionTrack {
+    #[default]
+    Scene,
+    Keep,
+    Stop,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct SongSection {
+    /// Zero uses the scene's existing automatic duration; otherwise 1–256 bars.
+    pub bars: u16,
+    pub tracks: [SectionTrack; NUM_TRACKS],
+}
+
+impl SongSection {
+    pub fn track_digits(&self) -> String {
+        self.tracks.iter().map(|action| match action {
+            SectionTrack::Scene => '0', SectionTrack::Keep => '1', SectionTrack::Stop => '2',
+        }).collect()
+    }
+}
+
+impl Engine {
+    pub fn song_sections_editable(&self) -> bool {
+        !self.playing && !self.pending_play
+    }
+
+    /// Targeted edits avoid read-modify-write races across the asynchronous UI
+    /// bridge. Every command applies to the latest recipe on the engine thread.
+    pub fn song_section_edit(&mut self, message: &str) -> bool {
+        let fields: Vec<_> = message.split_whitespace().collect();
+        let Some(index) = fields.first().and_then(|value| value.parse::<usize>().ok()) else { return false; };
+        if index >= self.song.len() { return false; }
+        let mut recipe = self.song_sections.get(&index).copied().unwrap_or_default();
+        match fields.as_slice() {
+            [_, "enable"] => {},
+            [_, "bars", value] => {
+                let Ok(bars) = value.parse::<u16>() else { return false; };
+                if bars > 256 { return false; }
+                recipe.bars = bars;
+            }
+            [_, "track", track, value] => {
+                let Ok(track) = track.parse::<usize>() else { return false; };
+                if track >= NUM_TRACKS { return false; }
+                recipe.tracks[track] = match *value {
+                    "0" => SectionTrack::Scene, "1" => SectionTrack::Keep,
+                    "2" => SectionTrack::Stop, _ => return false,
+                };
+            }
+            _ => return false,
+        }
+        self.song_sections.insert(index, recipe);
+        true
+    }
+
+    /// Strict, atomic configuration parser shared by commands and persistence.
+    /// The command bridge rejects edits while playing; loading can restore them.
+    pub fn song_section_set(&mut self, message: &str) -> bool {
+        let mut fields = message.split_whitespace();
+        let (Some(index), Some(bars), Some(digits)) = (fields.next(), fields.next(), fields.next()) else { return false; };
+        let (Ok(index), Ok(bars)) = (index.parse::<usize>(), bars.parse::<u16>()) else { return false; };
+        if fields.next().is_some() || index >= self.song.len() || bars > 256 || digits.len() != NUM_TRACKS { return false; }
+        let mut tracks = [SectionTrack::Scene; NUM_TRACKS];
+        for (track, digit) in tracks.iter_mut().zip(digits.bytes()) {
+            *track = match digit { b'0' => SectionTrack::Scene, b'1' => SectionTrack::Keep,
+                b'2' => SectionTrack::Stop, _ => return false };
+        }
+        self.song_sections.insert(index, SongSection { bars, tracks });
+        true
+    }
+
+    pub fn song_section_bars(&self, index: usize) -> u32 {
+        let Some((scene, repeats)) = self.song_entry_at(index) else { return 1; };
+        match self.song_sections.get(&index) {
+            Some(section) if section.bars > 0 => u32::from(section.bars),
+            _ => self.scene_bars(scene).saturating_mul(repeats),
+        }
+    }
+
+    fn song_section_terminal(&self, index: usize) -> bool {
+        !self.song_sections.contains_key(&index)
+            && self.song.get(index).is_some_and(|scene| self.scene_is_empty(*scene as usize))
+    }
+
+    /// Reuse the same queued slots, stops, gate releases and deferred selection
+    /// as launch_scene. Keep never restarts a donor, including its scale/cycle.
+    fn launch_song_section(&mut self, index: usize) {
+        let Some(&scene) = self.song.get(index) else { return; };
+        let scene = scene as usize;
+        let Some(recipe) = self.song_sections.get(&index).copied() else {
+            self.launch_scene(scene);
+            return;
+        };
+        // Song transitions are always armed while transport is running.
+        for (track, t) in self.tracks.iter_mut().enumerate() {
+            t.queued_slot = None;
+            t.pending_stop = false;
+            t.pending_select = None;
+            match recipe.tracks[track] {
+                SectionTrack::Keep => {},
+                SectionTrack::Stop => t.pending_stop = true,
+                SectionTrack::Scene => {
+                    if t.clips[scene].exists() { t.queued_slot = Some(scene); }
+                    else { t.pending_stop = true; t.pending_select = Some(scene); }
+                }
+            }
+        }
+    }
+
+    pub fn song_section_message(&self, index: usize) -> Option<String> {
+        let scene = *self.song.get(index)?;
+        let section = self.song_sections.get(&index);
+        let recipe = section.copied().unwrap_or_default();
+        Some(format!("{} {} {} {} {}", index, scene, section.is_some() as u8,
+            recipe.bars, recipe.track_digits()))
+    }
+
+    fn song_section_status(&self) -> String {
+        match self.song_entry_at(self.song_pos) {
+            Some((_, repeats)) => format!("{}:{}:{}", self.song_pos, repeats,
+                self.song_section_terminal(self.song_pos) as u8),
+            None => "-".into(),
+        }
+    }
+
+    /// On-demand observation only. No UI callback advances time or changes queues.
+    /// Epoch + visit identify a traversal within this engine lifetime; clients
+    /// must establish a new baseline after reconnecting or replacing the engine.
+    pub fn song_section_snapshot(&self) -> String {
+        let running = self.playing && self.song_start_bar.is_some();
+        let terminal = self.song_section_terminal(self.song_pos);
+        let current = match self.song_entry_at(self.song_pos) {
+            Some((scene, repeats)) => {
+                let start = if running { self.song_start_bar.map(|bar| bar.saturating_mul(TICKS_PER_BAR as u64)) } else { None };
+                let end = start.filter(|_| !terminal).map(|tick| tick.saturating_add(u64::from(self.song_section_bars(self.song_pos)) * TICKS_PER_BAR as u64));
+                format!("{{\"index\":{},\"scene\":{},\"repeats\":{},\"bars\":{},\"start_tick\":{},\"end_tick\":{},\"terminal\":{}}}",
+                    self.song_pos, scene, repeats, self.song_section_bars(self.song_pos),
+                    start.map_or("null".into(), |tick| tick.to_string()),
+                    end.map_or("null".into(), |tick| tick.to_string()), terminal)
+            }
+            None => "null".into(),
+        };
+        let next = if running && !terminal && !self.song.is_empty() {
+            let index = self.song_next_pos(self.song_pos);
+            format!("{{\"index\":{},\"scene\":{},\"committed\":{}}}", index, self.song[index], self.song_armed)
+        } else { "null".into() };
+        format!("{{\"schema\":1,\"epoch\":{},\"visit\":{},\"tick\":{},\"ticks_per_bar\":{},\"playing\":{},\"editable\":{},\"started\":{},\"count\":{},\"current\":{},\"next\":{}}}",
+            self.song_epoch, self.song_visit, self.master_tick, TICKS_PER_BAR, self.playing,
+            !self.playing && !self.pending_play, running, self.song.len(), current, next)
+    }
+}
