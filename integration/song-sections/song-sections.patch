diff --git a/src/seq/section-panels.ts b/src/seq/section-panels.ts
new file mode 100644
index 00000000..0f92363b
--- /dev/null
+++ b/src/seq/section-panels.ts
@@ -0,0 +1,81 @@
+/** Shared production Song editor. Scheduling and saved recipes stay in Rust. */
+import { engineReady, seqCmdFlush } from './engine.js';
+import { beginEdit, CLOSE } from '../undo/group.js';
+import { seqEdit } from '../undo/record.js';
+import { seqToast } from './render.js';
+
+const prefix='joint_section_';
+const numbered=(count:number):string[]=>Array.from({length:count},(_,index)=>String(index+1));
+const enumeration=(field:string,name:string,options:string[])=>({key:prefix+field,name,short_name:name,type:'enum',options,options_as_string:true,default:options[0]});
+const readOnly=(field:string,name:string)=>({key:prefix+field,name,short_name:name,type:'string',readOnly:true,access:'read'});
+export const sectionParameters=[
+    enumeration('entry','Entry',numbered(128)),
+    enumeration('bars','Bars',['Auto',...numbered(256)]),
+    enumeration('track','Track',numbered(16)),
+    enumeration('action','Transition',['Scene','Keep','Stop']),
+    enumeration('mode','Recipe',['Legacy','Section']),
+    readOnly('state','Edit State'),readOnly('current','Now'),readOnly('next','Next'),
+    readOnly('scene','Scene'),
+];
+export function sectionHierarchy(hierarchy:any):any {
+    hierarchy.levels.joint_sections={name:'Song Sections',knobs:sectionParameters.slice(0,8).map(parameter=>parameter.key),params:sectionParameters.map(parameter=>({key:parameter.key}))};
+    hierarchy.levels.root.params.unshift({level:'joint_sections'});
+    return hierarchy;
+}
+let entry=0,track=0;
+let cachedState:{at:number;value:any}|null=null;
+export function resetSectionPanel():void {entry=0;track=0;cachedState=null;}
+function read(key:string):string|null {
+    return typeof host_module_get_param==='function'?host_module_get_param(key):null;
+}
+function snapshot(fresh=false):any {
+    const now=Date.now();
+    if(!fresh&&cachedState&&now>=cachedState.at&&now-cachedState.at<100)return cachedState.value;
+    let value:any=null;
+    try {const parsed=JSON.parse(read('song_section')??'null');if(parsed?.schema===1)value=parsed;}catch(_){}
+    cachedState={at:now,value};return value;
+}
+function recipe():{scene:number;configured:boolean;bars:number;actions:string}|null {
+    const parts=(read('song_section_'+entry)??'').trim().split(/\s+/);
+    if(parts.length!==5||Number(parts[0])!==entry||!/^\d+$/.test(parts[1])||!/^[01]$/.test(parts[2])||!/^\d+$/.test(parts[3])||!/^[012]{16}$/.test(parts[4]))return null;
+    return {scene:Number(parts[1]),configured:parts[2]==='1',bars:Number(parts[3]),actions:parts[4]};
+}
+const label=(value:any):string=>value?'Entry '+(value.index+1)+' Scene '+(value.scene+1):'--';
+export function sectionPanelGet(key:string):string|null {
+    if(!key.startsWith(prefix))return null;
+    const field=key.slice(prefix.length);
+    if(field==='entry')return String(entry+1);
+    if(field==='track')return String(track+1);
+    if(['state','current','next'].includes(field)){
+        const state=snapshot();
+        if(!state)return 'Unavailable';
+        if(field==='state')return !state.count?'Build Song first':state.editable?'Stopped - edit':state.playing?'Stop to edit':'Waiting - stop';
+        if(field==='current')return label(state.current)+(state.current?.terminal?' END':'');
+        return label(state.next)+(state.next?.committed?' queued':state.next?' forecast':'');
+    }
+    const value=recipe();
+    if(field==='scene')return value?String(value.scene+1):'No entry';
+    if(field==='mode')return value?.configured?'Section':'Legacy';
+    if(field==='bars')return value?.bars?String(value.bars):'Auto';
+    if(field==='action')return ['Scene','Keep','Stop'][Number(value?.actions[track]??0)];
+    return '--';
+}
+export function sectionPanelSet(key:string,value:string):boolean {
+    if(!key.startsWith(prefix))return false;
+    const field=key.slice(prefix.length);
+    const parameter=sectionParameters.find(parameter=>parameter.key===key);
+    if(!parameter||!('options' in parameter))return true;
+    const selected=parameter.options.indexOf(value);
+    if(selected<0)return true;
+    if(field==='entry'){entry=selected;return true;}
+    if(field==='track'){track=selected;return true;}
+    const state=snapshot(true);
+    if(!engineReady()||!state)return true;
+    if(!state.editable){seqToast('Stop to edit song');return true;}
+    if(entry>=state.count){seqToast('Build song entry first');return true;}
+    const command=field==='mode'?(selected?'songsection '+entry+' enable':'songsectionclear '+entry)
+        :field==='bars'?'songsection '+entry+' bars '+selected
+        :'songsection '+entry+' track '+track+' '+selected;
+    beginEdit({key:'song-section-'+entry+'-'+field+(field==='action'?'-'+track:''),verb:'Song Section',target:'Entry '+(entry+1),close:CLOSE.IDLE,seq:true});
+    seqEdit(command);seqCmdFlush();return true;
+}
