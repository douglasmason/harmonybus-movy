+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {installEnv} from './env.mjs';
+installEnv();await import('../dist/esm/app/globals.js');
+const {installMockEngine}=await import('./mock-engine.mjs');
+const {seqEngineTick,resetSeqEngine}=await import('../dist/esm/seq/engine.js');
+const {seqState,resetSeqState}=await import('../dist/esm/seq/state.js');
+const {installEditGuard,setUndoStrict}=await import('../dist/esm/undo/record.js');
+const panel=await import('../dist/esm/seq/section-panels.js');
+const {jointHierarchy}=await import('../dist/esm/seq/joint-panels.js');
+const engine=installMockEngine();resetSeqEngine();resetSeqState();
+seqEngineTick();seqEngineTick();installEditGuard();setUndoStrict(true);
+const nativeRead=globalThis.host_module_get_param;
+let state={schema:1,editable:true,playing:false,count:3,current:{index:0,scene:0},next:null};
+let reads=0;
+globalThis.host_module_get_param=key=>{
+    if(key==='song_section'){reads++;return JSON.stringify(state);}
+    if(key==='song_section_0')return '0 0 1 8 0000100000000000';
+    if(key==='song_section_1')return '1 0 0 0 0000000000000000';
+    return nativeRead(key);
+};
+assert.equal(panel.sectionPanelGet('unrelated'),null);
+assert.equal(panel.sectionPanelGet('joint_section_bars'),'8');
+panel.sectionPanelSet('joint_section_track','5');
+assert.equal(panel.sectionPanelGet('joint_section_action'),'Keep');
+assert.equal(panel.sectionPanelGet('joint_section_state'),'Stopped - edit');
+assert.equal(panel.sectionPanelGet('joint_section_current'),'Entry 1 Scene 1');
+assert.equal(panel.sectionPanelGet('joint_section_next'),'--');
+assert.equal(reads,1,'status fields share one on-demand observation');
+const before=engine.ops.length;
+for(let read=0;read<20;read++)panel.sectionPanelGet('joint_section_current');
+assert.equal(engine.ops.length,before,'observer never sends commands');
+panel.sectionPanelSet('joint_section_bars','12');
+panel.sectionPanelSet('joint_section_action','Stop');
+assert(engine.ops.includes('songsection 0 bars 12'));
+assert(engine.ops.includes('songsection 0 track 4 2'));
+assert(engine.ops.some(op=>op.startsWith('usnap ')),'ordinary Undo snapshot owns recipe edits');
+panel.sectionPanelSet('joint_section_mode','Legacy');
+assert(engine.ops.includes('songsectionclear 0'));
+panel.sectionPanelSet('joint_section_entry','2');
+assert.equal(panel.sectionPanelGet('joint_section_mode'),'Legacy');
+panel.sectionPanelSet('joint_section_mode','Section');
+assert(engine.ops.includes('songsection 1 enable'));
+state={...state,editable:false,playing:true};
+const running=engine.ops.length;
+panel.sectionPanelSet('joint_section_bars','4');
+assert.equal(engine.ops.length,running,'playing guard also exists at the UI boundary');
+state={...state,editable:true,playing:false};
+panel.sectionPanelSet('joint_section_entry','128');
+panel.sectionPanelSet('joint_section_bars','4');
+assert.equal(engine.ops.length,running,'unbuilt entry cannot silently create clips or songs');
+panel.resetSectionPanel();
+assert.equal(panel.sectionPanelGet('joint_section_entry'),'1');
+assert.equal(panel.sectionPanelGet('joint_section_track'),'1');
+const hierarchy=jointHierarchy({levels:{root:{params:[]}}});
+assert.equal(hierarchy.levels.joint_sections.name,'Song Sections');
+assert.equal(hierarchy.levels.joint_sections.knobs.length,8);
+assert.equal(hierarchy.levels.root.params[0].level,'joint_sections');
+engine.status.song='1:0,0,1';engine.status.section='1:1:0';
+for(let tick=0;tick<10;tick++)seqEngineTick();
+assert.deepEqual(seqState.songSection,{pos:1,reps:1,terminal:false});
+const {songBandTokens,songTerminal}=await import('../dist/esm/seq/song.js');
+assert.deepEqual(songBandTokens([0,0,1],0,1000,word=>word.length,1).tokens.map(token=>token.current),[true,false,false]);
+assert.equal(songTerminal(),false,'explicit empty section uses engine terminal state');
+console.log('Song sections: shared panel, Undo grouping, stopped guard, indexed track policy, read neutrality and status parsing pass');
+
+// Exercise the production Schwung controller, not just the parameter adapter.
+const {schwungLibAvailable}=await import('../dist/esm/renderer/schwung-lib.js');
+assert(schwungLibAvailable(),'Requires the real shared controller');
+const {portFor}=await import('../dist/esm/track/registry.js');
+const {appState}=await import('../dist/esm/app/state.js');
+const {jointPage}=await import('../dist/esm/seq/joint-panels.js');
+const module=JSON.parse(readFileSync(process.env.HB_MODULE,'utf8'));
+const port=portFor(3);
+port.getParam=key=>{
+    if(key==='midi_fx1_module')return 'harmonybus';
+    const field=key.split(':').at(-1);
+    if(field==='chain_params')return JSON.stringify(module.capabilities.chain_params);
+    if(field==='ui_hierarchy')return JSON.stringify(module.capabilities.ui_hierarchy);
+    return '';
+};
+appState.focusGroup=0;
+let now=10000;Date.now=()=>now;
+const page=jointPage();assert(page.ready);
+const index=page.ctl.pages.findIndex(item=>item.keys?.includes('joint_section_bars'));
+assert(index>=0);page.goToPage(index);
+const flush=()=>{for(let tick=0;tick<4;tick++){now+=100;page.tick();}};
+flush();
+const prior=engine.ops.length;
+page.knobTurn(1,4);flush();
+assert(engine.ops.slice(prior).includes('songsection 0 bars 9'),'Bars knob sends targeted command through shared controller');
+page.knobTurn(2,4);flush();
+assert.equal(page.performanceGet('joint_section_track'),'2');
+page.knobTurn(3,4);flush();
+assert(engine.ops.includes('songsection 0 track 1 1'),'transition knob targets selected physical track');
+const observed=engine.ops.length;
+for(const slot of [5,6,7]){page.knobTurn(slot,4);page.knobTouch(slot,true);page.knobTouch(slot,false);}
+flush();assert.equal(engine.ops.length,observed,'observation knobs are read-only');
+console.log('Song Sections: real shared controller edits Bars/Track/Transition and preserves read-only observations');
