@@ -0,0 +1,267 @@
+#[cfg(test)]
+mod song_section_tests {
+    use super::*;
+    use crate::{command::apply_batch, persist};
+
+    fn prepared() -> Engine {
+        let mut engine = Engine::new(48000, 12000);
+        for scene in 0..3 {
+            engine.tracks[0].clips[scene].length_steps = 16;
+            engine.tracks[0].clips[scene].toggle_step(0, &[(60 + scene as u8, 100)]);
+        }
+        engine.song = vec![0, 1, 2];
+        engine
+    }
+
+    fn through(engine: &mut Engine, tick: u64) -> Vec<OutEvent> {
+        let mut output = Vec::new();
+        while engine.master_tick <= tick { engine.service_tick(&mut output); }
+        output
+    }
+
+    #[test]
+    fn explicit_bars_ignore_long_donors_and_keep_their_phase_and_cycle() {
+        let mut engine = prepared();
+        engine.tracks[4].clips[0].length_steps = 48; // independent 3-bar donor
+        engine.tracks[4].clips[0].toggle_step(0, &[(45, 90)]);
+        assert!(engine.song_section_edit("0 bars 8"));
+        assert!(engine.song_section_edit("1 bars 2"));
+        assert!(engine.song_section_edit("1 track 4 1"));
+        engine.play();
+        through(&mut engine, 7 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 0);
+        assert_eq!(engine.tracks[0].queued_slot, Some(1));
+        assert_eq!(engine.tracks[4].queued_slot, None);
+        assert!(!engine.tracks[4].pending_stop);
+        through(&mut engine, 8 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(engine.tracks[0].playing_slot, Some(1));
+        assert_eq!(engine.tracks[4].playing_slot, Some(0));
+        assert_eq!(engine.tracks[4].active_clip, 0);
+        assert_eq!(engine.tracks[4].cycle, 3);
+        assert_eq!(engine.tracks[4].pos_tick, 2 * TICKS_PER_BAR + 1);
+        assert_eq!(engine.song_start_bar, Some(8));
+    }
+
+    #[test]
+    fn real_audio_clock_weaving_survives_a_section_boundary_without_donor_restart() {
+        let mut engine = prepared();
+        for track in 1..4 { engine.tracks[track].clips[0].set_loop(0, 16); }
+        engine.tracks[1].clips[0].set_loop(0, 48);
+        engine.tracks[1].clips[0].add_note_raw(0, 0, 48, 60, 100);
+        engine.tracks[1].clips[0].add_note_raw(16, TICKS_PER_BAR, 48, 67, 100);
+        engine.tracks[2].clips[0].set_loop(0, 64);
+        engine.tracks[2].clips[0].add_note_raw(0, 0, 24, 36, 100);
+        engine.tracks[2].clips[0].add_note_raw(20, TICKS_PER_BAR + 96, 24, 36, 100);
+        engine.tracks[3].clips[0].add_note_raw(0, 0, 24, 30, 100);
+        engine.source_route_set("3 1 1 0 2 0 1");
+        engine.song_section_edit("0 bars 1");
+        engine.song_section_edit("1 bars 2");
+        for track in 1..4 { engine.song_section_edit(&format!("1 track {track} 1")); }
+        engine.play();
+        let mut attacks = Vec::new();
+        for _ in 0..(TICKS_PER_BAR + 130) {
+            let mut output = Vec::new();
+            // 250 frames is one 96-PPQN tick at 120 BPM / 48 kHz.
+            engine.advance_block(250, &mut output);
+            attacks.extend(output.iter().filter_map(|event| match event {
+                OutEvent::NoteOn { track:3, pitch, .. } => Some(*pitch), _ => None,
+            }));
+        }
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(attacks, vec![60, 67], "the post-boundary rhythm attack reads donor phase");
+        assert_eq!(engine.tracks[1].playing_slot, Some(0));
+        assert_eq!(engine.tracks[2].playing_slot, Some(0));
+        assert!(engine.gates.iter().all(|gate| gate.track != 3), "borrowed gate releases normally");
+    }
+
+    #[test]
+    fn explicit_occurrences_split_legacy_repeats_and_same_scene_applies_recipe() {
+        let mut engine = prepared();
+        engine.song = vec![0, 0, 0, 1];
+        assert_eq!(engine.song_entry_at(0), Some((0, 3)));
+        assert!(engine.song_section_edit("1 bars 2"));
+        assert!(engine.song_section_edit("1 track 0 2"));
+        assert_eq!(engine.song_entry_at(0), Some((0, 1)));
+        assert_eq!(engine.song_entry_at(1), Some((0, 1)));
+        assert_eq!(engine.song_next_pos(1), 2);
+        engine.play();
+        through(&mut engine, TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(engine.tracks[0].playing_slot, None);
+        through(&mut engine, 3 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 2);
+        assert_eq!(engine.tracks[0].playing_slot, Some(0), "leaving explicit Stop restores Scene semantics");
+    }
+
+    #[test]
+    fn stop_releases_an_owned_note_and_keep_retains_scaled_phase() {
+        let mut engine = prepared();
+        engine.tracks[0].clips[0].notes[0].gate = 3 * TICKS_PER_BAR;
+        engine.tracks[4].clips[0].length_steps = 48;
+        engine.tracks[4].clips[0].scale_num = 2;
+        engine.tracks[4].clips[0].scale_den = 3;
+        engine.song_section_edit("0 bars 1");
+        engine.song_section_edit("1 bars 1");
+        engine.song_section_edit("1 track 0 2");
+        engine.song_section_edit("1 track 4 1");
+        engine.play();
+        let output = through(&mut engine, TICKS_PER_BAR as u64);
+        assert_eq!(output.iter().filter(|event| matches!(event, OutEvent::NoteOff{track:0,pitch:60})).count(), 1);
+        assert_eq!(engine.tracks[4].pos_tick, (TICKS_PER_BAR + 1) * 2 / 3);
+        assert_eq!(engine.tracks[4].scale_acc, (TICKS_PER_BAR + 1) * 2 % 3);
+    }
+
+    #[test]
+    fn empty_legacy_scene_is_terminal_but_explicit_rest_has_a_duration() {
+        let mut engine = prepared();
+        engine.song = vec![7, 1];
+        assert!(engine.song_section_terminal(0));
+        engine.song_section_edit("0 bars 2");
+        assert!(!engine.song_section_terminal(0));
+        engine.play();
+        through(&mut engine, 2 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(engine.tracks[0].playing_slot, Some(1));
+    }
+
+    #[test]
+    fn recipes_round_trip_and_legacy_load_clears_them() {
+        let mut engine = prepared();
+        apply_batch(&mut engine, "songsection 0 bars 8;songsection 1 track 4 1;songsection 2 track 0 2", &mut Vec::new());
+        let saved = persist::serialize(&engine);
+        let mut restored = Engine::new(48000, 12000);
+        assert!(persist::load(&mut restored, &saved));
+        assert_eq!(restored.song_sections, engine.song_sections);
+        assert_eq!(persist::serialize(&restored), saved);
+        // First-entry Keep restarts the saved selected clip, not a stale runtime slot.
+        restored.tracks[4].clips[3].length_steps = 48;
+        restored.tracks[4].active_clip = 3;
+        restored.song_section_edit("0 track 4 1");
+        restored.play();
+        assert_eq!(restored.tracks[4].playing_slot, Some(3));
+        assert!(persist::load(&mut restored, "movy1\nsg 0 0 1\n"));
+        assert!(restored.song_sections.is_empty());
+        assert_eq!(restored.song_entry_at(0), Some((0, 2)));
+    }
+
+    #[test]
+    fn strict_commands_cannot_edit_a_running_or_pending_launch() {
+        let mut engine = prepared();
+        for command in ["songsection -1 bars 8", "songsection 0 bars 257", "songsection 0 bars -1", "songsection 9 enable", "songsection 0 track 16 1", "songsection 0 track 1 9", "songsection 0 bars 8 junk"] {
+            apply_batch(&mut engine, command, &mut Vec::new());
+            assert!(engine.song_sections.is_empty(), "{command}");
+        }
+        engine.pending_play = true;
+        apply_batch(&mut engine, "songsection 0 bars 8", &mut Vec::new());
+        assert!(engine.song_sections.is_empty());
+        engine.pending_play = false;
+        apply_batch(&mut engine, "songsection 0 bars 8;songsection 0 track 4 1", &mut Vec::new());
+        let config = engine.song_sections.clone();
+        apply_batch(&mut engine, "songsectionclear 0 junk", &mut Vec::new());
+        assert_eq!(engine.song_sections, config);
+        engine.play();
+        apply_batch(&mut engine, "songsection 0 bars 2;songsectionclear 0", &mut Vec::new());
+        assert_eq!(engine.song_sections, config);
+        assert!(!engine.song_section_set("0 8 000000000000000x"));
+        assert_eq!(engine.song_sections, config, "invalid import is atomic");
+    }
+
+    #[test]
+    fn snapshot_is_neutral_and_distinguishes_forecast_commit_and_occurrence() {
+        let mut engine = prepared();
+        engine.song_section_edit("0 bars 2");
+        engine.play();
+        let epoch = engine.song_epoch;
+        assert!(engine.song_section_snapshot().contains("\"started\":false"));
+        through(&mut engine, 1);
+        let state = engine.song_section_snapshot();
+        assert!(state.contains("\"committed\":false"));
+        assert!(state.contains(&format!("\"end_tick\":{}", 2 * TICKS_PER_BAR)));
+        let before = (engine.master_tick, engine.song_visit, engine.tracks[0].pos_tick, engine.tracks[0].queued_slot);
+        for _ in 0..50 { assert_eq!(engine.song_section_snapshot(), state); }
+        assert_eq!((engine.master_tick, engine.song_visit, engine.tracks[0].pos_tick, engine.tracks[0].queued_slot), before);
+        through(&mut engine, TICKS_PER_BAR as u64);
+        assert!(engine.song_section_snapshot().contains("\"committed\":true"));
+        through(&mut engine, 2 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_visit, 1);
+        engine.stop(&mut Vec::new());
+        assert!(engine.song_section_snapshot().contains("\"start_tick\":null"));
+        assert!(engine.song_section_snapshot().contains("\"next\":null"));
+        engine.play();
+        assert_ne!(engine.song_epoch, epoch);
+        assert_eq!(engine.song_visit, 0);
+    }
+
+    #[test]
+    fn undo_restores_recipe_and_preserves_unrelated_running_song_cursor() {
+        let mut engine = prepared();
+        apply_batch(&mut engine, "usnap 1;songsection 0 bars 2;uswap 1 2", &mut Vec::new());
+        assert!(engine.song_sections.is_empty());
+        apply_batch(&mut engine, "uswap 2 3", &mut Vec::new());
+        assert_eq!(engine.song_sections[&0].bars, 2);
+        engine.play();
+        through(&mut engine, 2 * TICKS_PER_BAR as u64);
+        let cursor = (engine.song_pos, engine.song_start_bar, engine.song_armed, engine.song_epoch, engine.song_visit);
+        let queued = engine.tracks[0].queued_slot;
+        let saved = persist::serialize(&engine);
+        assert!(engine.undo_restore(&saved));
+        assert_eq!((engine.song_pos, engine.song_start_bar, engine.song_armed, engine.song_epoch, engine.song_visit), cursor);
+        assert_eq!(engine.tracks[0].queued_slot, queued);
+        let mut modified = prepared();
+        modified.song_section_edit("0 bars 4");
+        assert!(engine.undo_restore(&persist::serialize(&modified)));
+        assert_eq!(engine.song_start_bar, None);
+        assert_eq!(engine.tracks[0].queued_slot, Some(0));
+        through(&mut engine, 3 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 0);
+        assert_eq!(engine.song_start_bar, Some(3));
+        assert_eq!(engine.tracks[0].playing_slot, Some(0));
+    }
+
+    #[test]
+    fn host_reanchor_restarts_current_section_without_a_stale_successor() {
+        let mut engine = prepared();
+        engine.song_section_edit("0 bars 2");
+        engine.song_section_edit("1 bars 2");
+        engine.play();
+        through(&mut engine, 3 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(engine.tracks[0].queued_slot, Some(2));
+        let epoch = engine.song_epoch;
+        // A first take can own a different queue while the song is armed.
+        engine.pending_rec = true;
+        engine.rec_track = 3;
+        engine.tracks[3].clips[5].length_steps = 16;
+        engine.tracks[3].queued_slot = Some(5);
+        engine.tracks[3].pending_stop = false;
+        engine.tracks[3].pending_select = None;
+        engine.on_external_realtime(0xFA, &mut Vec::new());
+        assert_ne!(engine.song_epoch, epoch);
+        assert_eq!(engine.tracks[3].queued_slot, Some(5));
+        through(&mut engine, 1);
+        assert_eq!(engine.tracks[3].playing_slot, Some(5));
+        assert!(engine.recording);
+        assert_eq!(engine.song_pos, 1);
+        assert_eq!(engine.song_start_bar, Some(0));
+        assert_eq!(engine.tracks[0].playing_slot, Some(1));
+        assert_eq!(engine.tracks[0].queued_slot, None);
+        through(&mut engine, 2 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.song_pos, 2);
+    }
+
+    #[test]
+    fn single_entry_keep_wraps_without_retrigger_and_manual_launch_clears_recipes() {
+        let mut engine = prepared();
+        engine.song = vec![0];
+        engine.song_section_edit("0 bars 1");
+        engine.song_section_edit("0 track 0 1");
+        engine.play();
+        through(&mut engine, 3 * TICKS_PER_BAR as u64);
+        assert_eq!(engine.tracks[0].cycle, 4);
+        assert_eq!(engine.song_visit, 3);
+        engine.launch_clip(0, 1);
+        assert!(engine.song.is_empty());
+        assert!(engine.song_sections.is_empty());
+    }
+}
